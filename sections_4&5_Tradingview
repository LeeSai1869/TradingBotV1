                candidateTransitionLowBar := na

    if bullishStructureActive and activeTransition == 0
        if structureCandidateHighBar > structureCandidateLowBar and not na(structureCandidateHighPrice) and not na(structureCandidateLowBar) and (newHighType == "LH" or newHighType == "EH")
            candidateTransitionHigh := structureCandidateHighPrice
