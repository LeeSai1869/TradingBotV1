            activeTransitionType := "bullishTransition"
            activeTransition := 1

    else if bearishStructureActive and activeTransition == 0
        if structureCandidateLowBar > structureCandidateHighBar and not na(structureCandidateLowPrice) and not na(structureCandidateHighBar) and (newLowType == "HL" or newLowType == "EL")
            candidateTransitionLow := structureCandidateLowPrice
            candidateTransitionLowBar := structureCandidateLowBar
            candidateTransitionHigh := na
            candidateTransitionHighBar := na
            activeTransitionType := "bearishTransition"
            activeTransition := 1

        else if structureCandidateHighBar > structureCandidateLowBar and not na(structureCandidateHighPrice) and not na(structureCandidateLowBar) and (newHighType == "HH" or newHighType == "EH")
            candidateTransitionHigh := structureCandidateHighPrice
            candidateTransitionHighBar := structureCandidateHighBar
            candidateTransitionLow := na
            candidateTransitionLowBar := na
            activeTransitionType := "bearishTransition"
            activeTransition := 1

    if rangeStructureActive and activeTransition == 0
        if c > structureRangeHigh
            activeTransitionType := "bearishTransition"
            array.push(structureTransition, activeTransitionType)
            activeTransition := 0

        else if c < structureRangeLow
            activeTransitionType := "bullishTransition"
            array.push(structureTransition, activeTransitionType)
            activeTransition := 0

    if activeTransition == 1
        if not validPivotHigh and lastConfirmedPivotType == 1
            int confirmedHighIndex = array.size(structurePivotHighBar) - 1
            int confirmedHighBar = array.get(structurePivotHighBar, confirmedHighIndex)
            if confirmedHighBar == candidateTransitionHighBar
                array.push(structureTransition, activeTransitionType)
                activeTransition := 0
                candidateTransitionHighBar := na
                candidateTransitionHigh := na

        else if not validPivotLow and lastConfirmedPivotType == -1
            int confirmedLowIndex = array.size(structurePivotLowBar) - 1
            int confirmedLowBar = array.get(structurePivotLowBar, confirmedLowIndex)
            if confirmedLowBar == candidateTransitionLowBar
                array.push(structureTransition, activeTransitionType)
                activeTransition := 0
                candidateTransitionLowBar := na
                candidateTransitionLow := na

    // Structure Invalidation / Break of Structure
    int transitionCount = array.size(structureTransition)
    string previousTransition = array.size(structureTransition) > 1 ? array.get(structureTransition, array.size(structureTransition) - 2) : ""
    string latestTransition = transitionCount > 0 ? array.get(structureTransition, transitionCount - 1) : ""
    int structureHighCount = array.size(structurePivotHighBar)
    int structureLowCount = array.size(structurePivotLowBar)
    int transitionHighBar = structureHighCount > 0 ? array.get(structurePivotHighBar, structureHighCount - 1) : na
    int transitionLowBar = structureLowCount > 0 ? array.get(structurePivotLowBar, structureLowCount - 1) : na
    var int bullBOSCount = 0
    var int bearBOSCount = 0
    var int rangeBOSCount = 0
    var string activeBOSType = ""
    var string activeCHOCH = ""
    float bullBOSDistanceATR = na
    float bearBOSDistanceATR = na

    // 0 = no BOS candidate
    // 1 = BOS developing
    // 2 = BOS confirmed / structure must reset
    var int activeBOS = 0
    var int bosCandidatePivotType = 0
    var int bosCandidatePivotBar = na
    if activeBOS == 1
        if bosCandidatePivotType == 1
            if prevCandidatePivotHighBar == bosCandidatePivotBar
                activeBOS := 0
                activeBOSType := ""
                bosCandidatePivotType := 0
                bosCandidatePivotBar := na

        else if bosCandidatePivotType == -1
            if prevCandidatePivotLowBar == bosCandidatePivotBar
                activeBOS := 0
                activeBOSType := ""
                bosCandidatePivotType := 0
                bosCandidatePivotBar := na

    if activeBOS == 0
        if bullishStructureActive and activeTransitionType == "bullishTransition" and latestTransition == "bullishTransition"
            if candidatePivotHighBar > transitionLowBar and (newHighType == "LH" or newHighType == "EH")
                bosCandidatePivotType := 1
                bosCandidatePivotBar := candidatePivotHighBar
                activeBOSType := "bullishBOS"
                activeBOS := 1

            else if candidatePivotLowBar > transitionHighBar and (newLowType == "LL" or newLowType == "EL")
                bosCandidatePivotType := -1
                bosCandidatePivotBar := candidatePivotLowBar
                activeBOSType := "bullishBOS"
                activeBOS := 1

        else if bearishStructureActive and activeTransitionType == "bearishTransition" and latestTransition == "bearishTransition"
            if candidatePivotLowBar > transitionHighBar and (newLowType == "HL" or newLowType == "EL")
                activeBOSType := "bearishBOS"
                activeBOS := 1
                bosCandidatePivotType := -1
                bosCandidatePivotBar := candidatePivotLowBar

            else if candidatePivotHighBar > transitionLowBar and (newHighType == "HH" or newHighType == "EH")
                activeBOSType := "bearishBOS"
                activeBOS := 1
                bosCandidatePivotType := 1
                bosCandidatePivotBar := candidatePivotHighBar

        else if rangeStructureActive
            if barstate.isconfirmed and not na(structureRangeHigh) and not na(structureRangeLow) and (c < structureRangeLow or c > structureRangeHigh)
                activeBOSType := "rangeBOS"
                activeBOS := 2

    if activeBOS == 1
        if bosCandidatePivotType == 1
            if prevCandidatePivotHighBar == bosCandidatePivotBar
                activeBOS := 0
                activeBOSType := ""
                activeCHOCH := ""
                bosCandidatePivotType := 0
                bosCandidatePivotBar := na
        
            else if validPivotHigh
                int confirmedHighIndex = array.size(structurePivotHighBar) - 1
                int confirmedHighBar = array.get(structurePivotHighBar, confirmedHighIndex)
                if confirmedHighBar == bosCandidatePivotBar
                    activeBOS := 2

        else if bosCandidatePivotType == -1
            if prevCandidatePivotLowBar == bosCandidatePivotBar
                activeBOS := 0
                activeBOSType := ""
                activeCHOCH := ""
                bosCandidatePivotType := 0
                bosCandidatePivotBar := na

            else if validPivotLow
                int confirmedLowIndex = array.size(structurePivotLowBar) - 1
                int confirmedLowBar = array.get(structurePivotLowBar, confirmedLowIndex)
                if confirmedLowBar == bosCandidatePivotBar
                    activeBOS := 2

    if activeBOS == 2
        if bosCandidatePivotType == 1
            int highIndex = array.size(structurePivotHigh) - 1

            if highIndex >= 1 and not na(currentATR) and currentATR > 0
                float currentHigh = array.get(structurePivotHigh, highIndex)
                float previousHigh = array.get(structurePivotHigh, highIndex - 1)

                float bosDistance = math.abs(currentHigh - previousHigh)

                if activeBOSType == "bullishBOS"
                    bullBOSDistanceATR := bosDistance / currentATR
                else if activeBOSType == "bearishBOS"
                    bearBOSDistanceATR := bosDistance / currentATR

        else if bosCandidatePivotType == -1
            int lowIndex = array.size(structurePivotLow) - 1

            if lowIndex >= 1 and not na(currentATR) and currentATR > 0
                float currentLow = array.get(structurePivotLow, lowIndex)
                float previousLow = array.get(structurePivotLow, lowIndex - 1)

                float bosDistance = math.abs(currentLow - previousLow)

                if activeBOSType == "bullishBOS"
                    bullBOSDistanceATR := bosDistance / currentATR
                else if activeBOSType == "bearishBOS"
                    bearBOSDistanceATR := bosDistance / currentATR
        array.push(structureBOS, activeBOSType)

        if activeBOSType == "bullishBOS"
            bullBOSCount += 1
        else if activeBOSType == "bearishBOS"
            bearBOSCount += 1
        else if activeBOSType == "rangeBOS"
