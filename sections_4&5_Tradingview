    for i = 0 to array.size(emaValues) - 1
        float emaValue = array.get(emaValues, i)

        if not na(emaValue)
            float emaDistance = math.abs(emaValue - c)
            float emaDistancePct = c != 0 ? emaDistance / c * 100 : na
            if emaValue > c
                if na(nearestBuyEMADistance) or emaDistance < nearestBuyEMADistance
                    nearestBuyEMA := emaValue
                    nearestBuyEMADistance := emaDistance
                    nearestBuyEMADistancePct := emaDistancePct

            if emaValue < c
                if na(nearestSellEMADistance) or emaDistance < nearestSellEMADistance
                    nearestSellEMA := emaValue
                    nearestSellEMADistance := emaDistance
                    nearestSellEMADistancePct := emaDistancePct

    // WMA 50
    float wma50 = ta.wma(c, 50)
    float wma50Distance = math.abs(wma50 - c)
    float wma50DistancePct = c != 0 ? wma50Distance / c * 100 : na

    //=========================
    // 4.2.4 VWAP
    //=========================
    float vwapValue = mtfData.vwapValue
    float vwapDistancePct = c != 0 ? (c - vwapValue) / c * 100 : na
    float vwapDistance = c != 0 ? (c - vwapValue) : na
    bool newVWAPSession = timeframe.change("1D")
    var float vwapCumulativeVolume = 0.0
    var float vwapCumulativePriceVolumeSquared = 0.0
    float vwapSource = hlc3

    if newVWAPSession
        vwapCumulativeVolume := volume
        vwapCumulativePriceVolumeSquared := volume * vwapSource * vwapSource
    else
        vwapCumulativeVolume += volume
        vwapCumulativePriceVolumeSquared += volume * vwapSource * vwapSource

    float vwapVariance = vwapCumulativeVolume > 0 ? (vwapCumulativePriceVolumeSquared / vwapCumulativeVolume) - (vwapValue * vwapValue) : na
    float vwapStdDev = not na(vwapVariance) ? math.sqrt(math.max(vwapVariance, 0.0)) : na
    float vwapUpper1 = not na(vwapStdDev) ? vwapValue + (vwapStdDev * vwapBandMultiplier1) : na
    float vwapLower1 = not na(vwapStdDev) ? vwapValue - (vwapStdDev * vwapBandMultiplier1) : na
    float vwapUpper2 = not na(vwapStdDev) ? vwapValue + (vwapStdDev * vwapBandMultiplier2) : na
    float vwapLower2 = not na(vwapStdDev) ? vwapValue - (vwapStdDev * vwapBandMultiplier2) : na

    // Buy Side
    float nearestBuyVWAP = na
    float nearestBuyVWAPDistance = na
    float nearestBuyVWAPDistancePct = na
    string nearestBuyVWAPType = ""
    float[] vwapValues = array.from(vwapLower2, vwapLower1, vwapValue, vwapUpper1, vwapUpper2)
    for i = 0 to array.size(vwapValues) - 1
        float vwapLevel = array.get(vwapValues, i)
        if not na(vwapLevel) and vwapLevel > c
            float distance = vwapLevel - c
            float distancePct = c != 0 ? distance / c * 100 : na

            if na(nearestBuyVWAPDistance) or distance < nearestBuyVWAPDistance
                nearestBuyVWAP := vwapLevel
                nearestBuyVWAPDistance := distance
                nearestBuyVWAPDistancePct := distancePct

                if i == 0
                    nearestBuyVWAPType := "LOWER_2"
                else if i == 1
                    nearestBuyVWAPType := "LOWER_1"
                else if i == 2
                    nearestBuyVWAPType := "VWAP"
                else if i == 3
                    nearestBuyVWAPType := "UPPER_1"
                else
                    nearestBuyVWAPType := "UPPER_2"

    // Sell Side
    float nearestSellVWAP = na
    float nearestSellVWAPDistance = na
    float nearestSellVWAPDistancePct = na
    string nearestSellVWAPType = ""
    for i = 0 to array.size(vwapValues) - 1
        float vwapLevel = array.get(vwapValues, i)

        if not na(vwapLevel) and vwapLevel < c
            float distance = c - vwapLevel
            float distancePct = c != 0 ? distance / c * 100 : na

            if na(nearestSellVWAPDistance) or distance < nearestSellVWAPDistance
                nearestSellVWAP := vwapLevel
                nearestSellVWAPDistance := distance
                nearestSellVWAPDistancePct := distancePct

                if i == 0
                    nearestSellVWAPType := "LOWER_2"
                else if i == 1
                    nearestSellVWAPType := "LOWER_1"
                else if i == 2
                    nearestSellVWAPType := "VWAP"
                else if i == 3
                    nearestSellVWAPType := "UPPER_1"
                else
                    nearestSellVWAPType := "UPPER_2"

    //=========================
    // 4.2.5 PRICE LOCATION
    //=========================
    bool priceAboveVWAP = c > vwapValue
    bool priceBelowVWAP = c < vwapValue
    bool priceAboveEMA50 = c > ema50
    bool priceBelowEMA50 = c < ema50
    bool priceAboveEMA200 = c > ema200
    bool priceBelowEMA200 = c < ema200
    bool priceAboveEMA300 = c > ema300
    bool priceBelowEMA300 = c < ema300

    //=========================
    // 4.2.6 MOMENTUM
    //=========================
    float rsi = ta.rsi(c, rsiLen)
    float prevRSI = rsi[1]
    float rsiChange = rsi - prevRSI
    [diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

    float prevADX = adx[1]
    float prevDIPlus = diPlus[1]
    float prevDIMinus = diMinus[1]
    float diDirection = diPlus - diMinus
    float diSpread = math.abs(diDirection)
    float diDominance  = (diPlus + diMinus) > 0 ? math.abs(diPlus - diMinus) / (diPlus + diMinus) : 0
    bool bullMomentumWeakening = diPlus < prevDIPlus and adx < prevADX
    bool bearMomentumWeakening = diMinus < prevDIMinus and adx < prevADX

    // Momentum Divergence
    int divergenceLookback = 5
    bool bullMomentumDivergence = l < l[divergenceLookback] and rsi > rsi[divergenceLookback]
    bool bearMomentumDivergence = h > h[divergenceLookback] and rsi < rsi[divergenceLookback]

    //=========================
    // 4.2.7 VOLATILITY
    //=========================
    float atr = ta.atr(atrLen)
    float currentATR = atr
    float atrMA = ta.sma(atr, atrMaLen)
    float atrMARatio = atrMA > 0 ? atr/atrMA : na
    float atrChange = atr - atr[1]
    float atrPercent = atr / c

    //=========================
    // 4.2.8 VOLUME DATA
    //=========================
    float volumeValue = mtfData.volume
    float prevVolume = mtfData.prevVolume
    float volumeMA = mtfData.volumeMA
    float volumeRatio = not na(volumeMA) and volumeMA > 0 ? volumeValue / volumeMA : 0.0
    float prevVolumeRatio = volumeRatio[1]

    //=========================
    // 4.2.9 SUPPORT AND RESISTANCE
    //=========================
    // DYNAMIC S/R LIFECYCLE — OWNERSHIP CONTRACT
    // Dynamic S/R is the sole owner of Dynamic Zone lifecycle.
    //
    // Dynamic lifecycle responsibilities:
    // - Create Dynamic zones
    // - Maintain Dynamic zone geometry
    // - Track Dynamic touches and reactions
    // - Detect Dynamic zone failure/break
    // - Maintain Dynamic zone state
    // - Remove Dynamic zones according to Dynamic lifecycle rules
    //
    // IMPORTANT:
    // Dynamic S/R MUST NOT update, score, validate, rank,
    // or otherwise manage Institutional lifecycle data.
    // However Dynamic S/R is responsible for removal of Invalid Institutional S/R
    // Dynamic S/R may expose its state/history through its own
    // arrays (for example InstSupportBreakBarArray).
    // Institutional lifecycle consumes Dynamic S/R state.
    // It is the Institutional lifecycle's responsibility to interpret
    // a Dynamic failure as an Institutional failure and update:
    // - instSupportFailureCountArray
    // - instSupportScoreArray
    // - Institutional ranking
    // - Institutional memory
    // NEVER place Institutional array updates inside this Dynamic lifecycle except for the purpose of Removal.

    var int nextSupportZoneSequence = 0
    var int nextResistanceZoneSequence = 0

    srZoneATRMultiplier = input.float(0.5, "SR Zone ATR Multiplier", step = 0.1)
    srMergeATRMultiplier = input.float(0.25, "SR Merge ATR Multiplier", step = 0.05)
    srZoneDistanceATR = input.float(2.0, "SR Zone Distance ATR", step = 0.25)
    srPivotLookback = input.int(5, "S/R Pivot Lookback", minval = 1, maxval = 20)
    srPivotRight = input.int(1, "S/R Pivot Right", minval = 1, maxval = 20)
    srReactionATR = input.float(0.5, "S/R Reaction ATR", minval = 0.0, step = 0.1)
    normalizationPower = input.float(1.0, "S/R Normalization Power", minval = 0.1, step = 0.05)

    float srPivotHigh = ta.pivothigh(h, srPivotLookback, srPivotRight)
    float srPivotLow = ta.pivotlow(l, srPivotLookback, srPivotRight)

    float pivotATR = atr[srPivotRight]

    float support = ta.valuewhen(not na(srPivotLow),srPivotLow,0)
    float resistance = ta.valuewhen(not na(srPivotHigh),srPivotHigh,0)

    float srZoneSize = pivotATR * srZoneATRMultiplier
    float srMergeDistance = pivotATR * srMergeATRMultiplier

    float supportHigh = not na(support) ? support + srZoneSize : na
    float supportLow = not na(support) ? support - srZoneSize : na

    float resistanceHigh = not na(resistance) ? resistance + srZoneSize : na
    float resistanceLow = not na(resistance) ? resistance - srZoneSize : na

    float supportDistance = na(support) ? na : atr > 0 ? (c - support) / atr : na
    float resistanceDistance = na(resistance) ? na : atr > 0 ? (resistance - c) / atr : na

    float supportReactionATR = atr > 0 ? (c - srPivotLow) / atr : 0.0
    float resistanceReactionATR = atr > 0 ? (srPivotHigh - c) / atr : 0.0

    float sZoneDistanceATR = atr > 0 and not na(supportHigh) and not na(supportLow) ? c > supportHigh ? (c - supportHigh) / atr : c < supportLow ? (supportLow - c) / atr : 0.0 : na
    float rZoneDistanceATR = atr > 0 and not na(resistanceHigh) and not na(resistanceLow) ? c > resistanceHigh ? (c - resistanceHigh) / atr : c < resistanceLow ? (resistanceLow - c) / atr : 0.0 : na

    bool nearSupport = sZoneDistanceATR <= srZoneDistanceATR
    bool nearResistance = rZoneDistanceATR <= srZoneDistanceATR

    float averageDynamicSupportScore = na
    float averageDynamicSupportES = na

    float averageDynamicResistanceScore = na
    float averageDynamicResistanceES = na

    float nearestSupportPrice = na
    float nearestResistancePrice = na

    float nearestSupportDistance = na
    float nearestResistanceDistance = na

    float nearestSupportZonePrice = na
    float nearestResistanceZonePrice = na

    float nearestSupportStrength = na
    float nearestResistanceStrength = na

    float nearestSupportES = na
    float nearestResistanceES = na

    float nearestSupportScore = na
    float nearestResistanceScore = na

    string nearestSupportZoneID = na
    string nearestResistanceZoneID = na

    string nearestSupportState = na
    string nearestResistanceState = na

    float nearestInstSupport = na
    float nearestInstResistance = na

    float nearestInstSupportDistanceATR = na
    float nearestInstResistanceDistanceATR = na

    float nearestInstSupportScore = na
    float nearestInstResistanceScore = na

    float nearestInstSupportStrength = na
    float nearestInstResistanceStrength = na

    float nearestInstSupportES = na
    float nearestInstResistanceES = na

    string nearestInstSupportZoneID = na
    string nearestInstResistanceZoneID = na

    bool nearInstSupport = false
    bool nearInstResistance = false

    float averageInstResistanceScore = na
    float averageInstResistanceES = na

    float averageInstSupportScore = na
    float averageInstSupportES = na

    int interactingSupportZoneId = na
    int interactingResistanceZoneId = na

    float nearestSupportZonePriceDistance = na
    float nearestResistanceZonePriceDistance = na

    string nearestSupportZonePriceID = na
    string nearestResistanceZonePriceID = na

    float nearestSupportZonePriceATR = na
    float nearestResistanceZonePriceATR = na

    float nearestSupportLastTestAge = na
    string nearestSupportLastTestType = na

    float nearestResistanceLastTestAge = na
    string nearestResistanceLastTestType = na

    float nearestInstSupportLastTestAge = na
    string nearestInstSupportLastTestType = na

    float nearestInstResistanceLastTestAge = na
    string nearestInstResistanceLastTestType = na

    float averageDynamicResistanceLastTestAge = na
    float averageDynamicSupportLastTestAge = na

    float averageInstResistanceLastTestAge = na
    float averageInstSupportLastTestAge = na

    float dynamicSupportLastTestAgeNormalized = na
    float dynamicResistanceLastTestAgeNormalized = na

    float instSupportLastTestAgeNormalized = na
    float instResistanceLastTestAgeNormalized = na

    float dynamicSupportESNormalized = na
    float dynamicResistanceESNormalized = na

    float instSupportESNormalized = na
    float instResistanceESNormalized = na

    int nearestSupportStrongTouches = na
    int nearestSupportWeakTouches = na
    int nearestInstSupportFailureCount = na

    int nearestResistanceStrongTouches = na
    int nearestResistanceWeakTouches = na
    int nearestInstResistanceFailureCount = na

    float dynamicSupportWTNormalized = na
    float dynamicResistanceWTNormalized = na
    float dynamicSupportSTNormalized = na
    float dynamicResistanceSTNormalized = na
    float instSupportWTNormalized = na
    float instResistanceWTNormalized = na
    float instSupportSTNormalized = na
    float instResistanceSTNormalized = na
    float instSupportFailureNormalized = na
    float instResistanceFailureNormalized = na

    // GLOBAL ZONE ID PREFIX
    // The prefix identifies where the Dynamic zone originated.
    string zoneTFPrefix =
         timeframe.period == "1"   ? "1m" :
         timeframe.period == "5"   ? "5m" :
         timeframe.period == "15"  ? "15m" :
         timeframe.period == "30"  ? "30m" :
         timeframe.period == "60"  ? "1H" :
         timeframe.period == "120" ? "2H" :
         timeframe.period == "240" ? "4H" :
         timeframe.period == "D"   ? "1D" :
         timeframe.period == "W"   ? "1W" :
         timeframe.period == "M"   ? "1M" :
         timeframe.period == "3M"  ? "3M" :
         timeframe.period == "6M"  ? "6M" :
         timeframe.period

    // SUPPORT ZONES
    // ==================
    // SUPPORT APPROACH DIRECTION
    if array.size(supportLowArray) > 0
        for supportZoneI = 0 to array.size(supportLowArray) - 1
            float supportZoneLow  = array.get(supportLowArray, supportZoneI)
            float supportZoneHigh = array.get(supportHighArray, supportZoneI)
            bool wasInsideSupportZone = array.get(prevCandleInsideSupportZoneArray, supportZoneI)
            bool insideSupportZone = bar_index > array.get(supportBarArray, supportZoneI) and l <= supportZoneHigh and h >= supportZoneLow
            int oldDirection = array.get(supportApproachDirectionArray, supportZoneI)
            int approachDirection = oldDirection

            if barstate.isconfirmed and c > supportZoneHigh and not insideSupportZone and not wasInsideSupportZone
                approachDirection := 1

            array.set(supportApproachDirectionArray, supportZoneI, approachDirection)

    // SUPPORT CREATION / IDENTIFICATION
    if barstate.isconfirmed and not na(srPivotLow) and supportReactionATR >= srReactionATR
        float potentialSupportLow = srPivotLow - srZoneSize
        float potentialSupportHigh = srPivotLow + srZoneSize
        bool insideInstitutionalSupport = false

        if array.size(instSupportZoneIDArray) > 0
            for instI = 0 to array.size(instSupportZoneIDArray) - 1
                string instSupportZoneID = array.get(instSupportZoneIDArray, instI)
                // The Institutional zone must exist in Dynamic S/R memory.
                int instDynamicIndex = array.indexof(supportZoneIDArray, instSupportZoneID)

                if instDynamicIndex != -1
                    float instSupportZoneLow = array.get(supportLowArray, instDynamicIndex)
                    float instSupportZoneHigh = array.get(supportHighArray, instDynamicIndex)
                    bool institutionalSupportOverlap = potentialSupportLow <= instSupportZoneHigh and potentialSupportHigh >= instSupportZoneLow

                    if institutionalSupportOverlap
                        insideInstitutionalSupport := true
                        break

        // Only create a Dynamic zone when it does not
        // conflict with an existing Institutional zone.
        if not insideInstitutionalSupport
            nextSupportZoneSequence += 1
            string newSupportZoneID = zoneTFPrefix + "-S-" + str.tostring(nextSupportZoneSequence, "000000")
            array.push(supportZoneIDArray, newSupportZoneID)
            array.push(supportLowArray, srPivotLow - srZoneSize)
            array.push(supportHighArray, srPivotLow + srZoneSize)
            array.push(supportOriginArray, srPivotLow)
            array.push(supportBarArray, bar_index - srPivotRight)
            array.push(supportTouchArray, 0)
            array.push(prevCandleInsideSupportZoneArray, false)
            array.push(supportLastTestBarArray, na)
            array.push(supportLastTestTypeArray, "NO_TEST")
            array.push(supportStrengthArray, 0)
            array.push(supportStrongRejectArray, 0)
            array.push(supportMaxPenetrationArray, 0.0)
            array.push(supportMaxWickRatioArray, 0.0)
            array.push(supportMaxReactionArray, 0.0)
            array.push(supportApproachDirectionArray, 0)
            array.push(supportOriginTimeArray, time[srPivotRight])
            array.push(supportScoreArray, 0.0)
            array.push(supportESArray, 0)
            array.push(supportZoneATRArray, pivotATR)

    if array.size(supportLowArray) > 0
        for i = array.size(supportLowArray) - 1 to 0
            float supportZoneLow = array.get(supportLowArray, i)
            float supportZoneHigh = array.get(supportHighArray, i)
            float supportZoneDistanceATR = atr > 0 ? (c > supportZoneHigh ? (c - supportZoneHigh) / atr : c < supportZoneLow ? (supportZoneLow - c) / atr : 0.0) : na
            bool wasInsideSupportZone = array.get(prevCandleInsideSupportZoneArray, i)
            bool insideSupportZone = bar_index > array.get(supportBarArray, i) and l <= supportZoneHigh and h >= supportZoneLow
            if insideSupportZone
                interactingSupportZoneId := i
            if barstate.isconfirmed
                array.set(prevCandleInsideSupportZoneArray, i, insideSupportZone)

            if supportZoneDistanceATR > srZoneDistanceATR and not (wasInsideSupportZone or insideSupportZone)
                continue
           
            int supportZoneAge = bar_index - array.get(supportBarArray, i)
            int lastSupportTestBar = supportLastTestBarArray.get(i)
            int barsSinceSupportTest = not na(lastSupportTestBar) ? bar_index - lastSupportTestBar : supportZoneAge
            bool wasApproachedFromAbove = array.get(supportApproachDirectionArray, i) == 1
            bool previousCandleCrossedZone = barstate.isconfirmed and h1 > supportZoneHigh and l1 < supportZoneLow and wasApproachedFromAbove
            bool supportInvalid = barstate.isconfirmed and h < supportZoneLow and (wasApproachedFromAbove or previousCandleCrossedZone)
     
            if supportInvalid
                string zoneID = array.get(supportZoneIDArray, i)
                int instIndex = array.indexof(instSupportZoneIDArray, zoneID)
                bool isSupportInstitutional = instIndex != -1

                if not isSupportInstitutional
                    array.remove(supportZoneIDArray, i)
                    array.remove(supportLowArray,i)
                    array.remove(supportHighArray,i)
                    array.remove(supportOriginArray,i)
                    array.remove(supportBarArray,i)
                    array.remove(supportTouchArray,i)
                    array.remove(prevCandleInsideSupportZoneArray,i)
                    array.remove(supportLastTestBarArray, i)
                    array.remove(supportLastTestTypeArray, i)
                    array.remove(supportStrengthArray, i)
                    array.remove(supportStrongRejectArray, i)
                    array.remove(supportMaxPenetrationArray, i)
                    array.remove(supportMaxWickRatioArray, i)
                    array.remove(supportMaxReactionArray, i)
                    array.remove(supportApproachDirectionArray, i)
                    array.remove(supportOriginTimeArray, i)
                    array.remove(supportScoreArray, i)
                    array.remove(supportESArray, i)
                    array.remove(supportZoneATRArray, i)

                if isSupportInstitutional
                    int oldFailureCount = array.get(instSupportFailureCountArray, instIndex)
                    array.set(InstSupportBreakBarArray, instIndex, bar_index)
                    array.set(instSupportFailureCountArray, instIndex, oldFailureCount + 1)
                    array.set(supportLastTestBarArray, i, bar_index)
                    array.set(supportLastTestTypeArray, i, "FAILED")
                    array.set(supportApproachDirectionArray, i, 0)
                    float instSupportScore = array.get(instSupportScoreArray, instIndex)

                    if instSupportScore <= 5
                        // remove institutional memory
                        array.remove(instSupportZoneIDArray, instIndex)
                        array.remove(instSupportScoreArray, instIndex)
                        array.remove(instSupportStrengthArray, instIndex)
                        array.remove(instQualifiedSupportTFListArray, instIndex)
                        array.remove(instSupportFailureCountArray, instIndex)
                        array.remove(InstSupportBreakBarArray, instIndex)

                        // Remove dynamic zone
                        array.remove(supportZoneIDArray, i)
                        array.remove(supportLowArray,i)
                        array.remove(supportHighArray,i)
                        array.remove(supportOriginArray,i)
                        array.remove(supportBarArray,i)
                        array.remove(supportTouchArray,i)
                        array.remove(prevCandleInsideSupportZoneArray,i)
                        array.remove(supportLastTestBarArray, i)
                        array.remove(supportLastTestTypeArray, i)
                        array.remove(supportStrengthArray, i)
                        array.remove(supportStrongRejectArray, i)
                        array.remove(supportMaxPenetrationArray, i)
                        array.remove(supportMaxWickRatioArray, i)
                        array.remove(supportMaxReactionArray, i)
                        array.remove(supportApproachDirectionArray, i)
                        array.remove(supportOriginTimeArray, i)
                        array.remove(supportScoreArray, i)
                        array.remove(supportESArray, i)
                        array.remove(supportZoneATRArray, i)

            else if barstate.isconfirmed
                int oldSupportTouches = array.get(supportTouchArray, i)
                float oldSupportStrength = array.get(supportStrengthArray, i)
                float supportZoneHeight = supportZoneHigh - supportZoneLow
                float supportPenetration = math.max(0.0, (supportZoneHigh - l) / supportZoneHeight)
                bool penetrationInsideSupportZone = l >= supportZoneLow and l <= supportZoneHigh
                if penetrationInsideSupportZone
                    float oldMaxPenetration = array.get(supportMaxPenetrationArray, i)
                    array.set(supportMaxPenetrationArray, i, math.max(oldMaxPenetration, supportPenetration))

                float wickSize = l < supportZoneLow ? supportZoneLow - l : 0
                float candleRange = h - l
                float wickRatio = candleRange > 0 ? wickSize / candleRange : 0
                float currentSupportReaction = c > supportZoneHigh ? (c - supportZoneHigh) / atr : 0
                float oldWick = array.get(supportMaxWickRatioArray,i)
                float oldReaction = array.get(supportMaxReactionArray,i)

                array.set(supportMaxWickRatioArray, i, math.max(oldWick, wickRatio))
                array.set(supportMaxReactionArray, i, math.max(oldReaction, currentSupportReaction))

                bool wickBelowSupport = l < supportZoneLow and c > supportZoneHigh
                if wasInsideSupportZone and wasApproachedFromAbove and l > supportZoneHigh
                    int newSupportTouches = oldSupportTouches + 1
                    array.set(supportTouchArray, i, newSupportTouches)
                    int strongSupportRejects = array.get(supportStrongRejectArray, i)
                    float currentSupportStrength = oldSupportStrength

                    if currentSupportReaction >= srReactionATR
                        currentSupportStrength += 5
                        strongSupportRejects += 1
                        array.set(supportLastTestTypeArray, i, "STRONG_REJECTION")

                    else
                        currentSupportStrength += 3
                        array.set(supportLastTestTypeArray, i, "WEAK_REACTION")

                    array.set(supportStrengthArray, i, currentSupportStrength)
                    array.set(supportStrongRejectArray, i, strongSupportRejects)
                    array.set(supportLastTestBarArray, i, bar_index)

                int supportTouches = array.get(supportTouchArray, i)
                int strongSupportRejects = array.get(supportStrongRejectArray, i)
                int weakSupportTouches = math.max(0, supportTouches - strongSupportRejects)
                float supportScore = strongSupportRejects * 5.0 + weakSupportTouches * 3.0
                array.set(supportScoreArray, i, supportScore)
                array.set(prevCandleInsideSupportZoneArray, i, insideSupportZone)

                float supportAgeFactor = 1 / (1 + supportZoneAge / 1000)
                float supportRecentTestFactor = 1 / (1 + barsSinceSupportTest / 500)
                string lastSupportTestType = array.get(supportLastTestTypeArray, i)
                float supportTestTypeFactor = 0.0

                if lastSupportTestType == "STRONG_REJECTION"
                    supportTestTypeFactor := 1.0
                else if lastSupportTestType == "WEAK_REACTION"
                    supportTestTypeFactor := 0.5
                else if lastSupportTestType == "FAILED"
                    supportTestTypeFactor := -1.0
                else
                    supportTestTypeFactor := 0.0

                float effectiveSupportStrength = 0.0
                string currentSupportZoneID = array.get(supportZoneIDArray, i)
                int instSupportIndex = array.indexof(instSupportZoneIDArray, currentSupportZoneID)
                if instSupportIndex != -1
                    effectiveSupportStrength := array.get(instSupportStrengthArray, instSupportIndex) * supportAgeFactor * supportRecentTestFactor * supportTestTypeFactor

                else
                    effectiveSupportStrength := array.get(supportStrengthArray, i) * supportAgeFactor * supportRecentTestFactor * supportTestTypeFactor
                array.set(supportESArray, i, effectiveSupportStrength)

                float supportDistanceATR = atr > 0 ? (c - supportZoneHigh) / atr : na
                if wasApproachedFromAbove and supportDistanceATR >= 0
                    if na(nearestSupportDistance) or supportDistanceATR < nearestSupportDistance
                        nearestSupportDistance := supportDistanceATR
                        nearestSupportPrice := supportZoneHigh
                        nearestSupportStrength := array.get(supportStrengthArray, i)
                        nearestSupportScore := array.get(supportScoreArray, i)
                        nearestSupportZoneID := array.get(supportZoneIDArray, i)
                        nearestSupportState := array.get(supportLastTestTypeArray, i)

                array.set(prevCandleInsideSupportZoneArray, i, insideSupportZone)

                float supportDistancePrice = na 
                if c >= supportZoneLow
                    supportDistancePrice := c - supportZoneLow

                if not na(supportDistancePrice)
                    if na(nearestSupportZonePriceDistance) or supportDistancePrice < nearestSupportZonePriceDistance
                        nearestSupportZonePrice := supportZoneLow
                        nearestSupportZonePriceID := array.get(supportZoneIDArray, i)
                        nearestSupportZonePriceDistance := supportDistancePrice
                        nearestSupportZonePriceATR := array.get(supportZoneATRArray, i)
                        nearestSupportES := array.get(supportESArray, i)

                        int lastTestBar = array.get(supportLastTestBarArray, i)
                        nearestSupportLastTestAge := not na(lastTestBar) ? bar_index - lastTestBar : na
                        nearestSupportLastTestType := array.get(supportLastTestTypeArray, i)
                        nearestSupportStrongTouches := array.get(supportStrongRejectArray, i)

                        int nearestSupportTotalTouches = array.get(supportTouchArray, i)
                        nearestSupportWeakTouches := math.max(0, nearestSupportTotalTouches - nearestSupportStrongTouches)

                        int instNearestSupportIndex = array.indexof(instSupportZoneIDArray, nearestSupportZonePriceID)
                        nearestInstSupportFailureCount := instNearestSupportIndex != -1 ? array.get(instSupportFailureCountArray, instNearestSupportIndex) : na

    // SUPPORT MERGE
    // Dynamic zones merge only when the newly created zone
    // overlaps / comes sufficiently close to an existing zone.
    // CONTRACT:
    // - Existing older zone survives.
    // - Older Zone ID remains authoritative.
    // - New Zone ID is destroyed after successful merge.
    // - No new Zone ID is created.
    // - Dynamic merge does NOT modify Institutional arrays.
    // - If the surviving Zone ID is institutional, its institutional
    //   memory automatically continues to reference that same ID.
    // - Surviving zone keeps its original height.
    // - Current ATR does NOT resize an existing zone.
    // Institutional zones are not created by this merge.
    // A newly created zone is normal at creation time.
    if barstate.isconfirmed and not na(srPivotLow) and array.size(supportLowArray) > 1
        int latestSupportIndex = array.size(supportLowArray) - 1
        string latestSupportZoneID = array.get(supportZoneIDArray, latestSupportIndex)
        float newSupportLow = array.get(supportLowArray, latestSupportIndex)
        float newSupportHigh = array.get(supportHighArray, latestSupportIndex)
        // Find the nearest existing zone that overlaps
        // or falls within the configured merge distance.
        int mergeSupportIndex = -1
        float nearestSupportMergeDistance = na
        for i = 0 to latestSupportIndex -1
            string existingSupportZoneID = array.get(supportZoneIDArray, i)
            bool existingZoneIsInstitutional = array.indexof(instSupportZoneIDArray, existingSupportZoneID) != -1
            if existingZoneIsInstitutional
                continue

            float existingSupportLow = array.get(supportLowArray,i)
            float existingSupportHigh =array.get(supportHighArray,i)
            float mergeSupportDistance = 0.0
            if newSupportLow > existingSupportHigh
                mergeSupportDistance := newSupportLow - existingSupportHigh

            else if newSupportHigh < existingSupportLow
                mergeSupportDistance := existingSupportLow - newSupportHigh
            else
                mergeSupportDistance := 0.0

            bool supportOverlap = mergeSupportDistance <= srMergeDistance
            if supportOverlap
                if na(nearestSupportMergeDistance) or mergeSupportDistance < nearestSupportMergeDistance
                    nearestSupportMergeDistance := mergeSupportDistance
                    mergeSupportIndex := i
        
        // Merge only when a valid existing zone was found.
        if mergeSupportIndex != -1
            float existingSupportLow = array.get(supportLowArray, mergeSupportIndex)
            float existingSupportHigh =array.get(supportHighArray, mergeSupportIndex)
            float survivingZoneHeight = existingSupportHigh - existingSupportLow
            string survivingSupportZoneID = array.get(supportZoneIDArray, mergeSupportIndex)
            float combinedLow = math.min(existingSupportLow, newSupportLow)
            float combinedHigh = math.max(existingSupportHigh, newSupportHigh)
            float mergedCenter = (combinedLow + combinedHigh) / 2.0
            float mergedLow = mergedCenter - survivingZoneHeight / 2.0
            float mergedHigh = mergedCenter + survivingZoneHeight / 2.0

            array.set(supportLowArray, mergeSupportIndex, mergedLow)
            array.set(supportHighArray, mergeSupportIndex, mergedHigh)

            // Keep oldest origin
            int oldBar = array.get(supportBarArray, mergeSupportIndex)
            int newBar = array.get(supportBarArray, latestSupportIndex)

            if newBar < oldBar
                array.set(supportBarArray, mergeSupportIndex, newBar)
                array.set(supportOriginArray, mergeSupportIndex, array.get(supportOriginArray, latestSupportIndex))
                array.set(supportOriginTimeArray, mergeSupportIndex, array.get(supportOriginTimeArray, latestSupportIndex))
                array.set(supportZoneATRArray, mergeSupportIndex, array.get(supportZoneATRArray, latestSupportIndex))

            // Merge touches
            int oldSupportTouches = array.get(supportTouchArray, mergeSupportIndex)
            int newSupportTouches = array.get(supportTouchArray, latestSupportIndex)
            array.set(supportTouchArray, mergeSupportIndex, oldSupportTouches + newSupportTouches)

            // MERGE STRENGTH MEMORY
            float oldStrength = array.get(supportStrengthArray, mergeSupportIndex)
            float newStrength = array.get(supportStrengthArray, latestSupportIndex)
            array.set(supportStrengthArray, mergeSupportIndex, math.max(oldStrength, newStrength))

            // MERGE EFFECTIVE STRENGTH MEMORY
            float oldES = array.get(supportESArray, mergeSupportIndex)
            float newES = array.get(supportESArray, latestSupportIndex)

            array.set(supportESArray, mergeSupportIndex, math.max(oldES, newES))

            // MERGE REJECTION MEMORY
            int oldReject = array.get(supportStrongRejectArray, mergeSupportIndex)
            int newReject = array.get(supportStrongRejectArray, latestSupportIndex)

            array.set(supportStrongRejectArray, mergeSupportIndex, oldReject + newReject)

            // MERGE LAST INTERACTION
            int oldLast = array.get(supportLastTestBarArray, mergeSupportIndex)
            int newLast = array.get(supportLastTestBarArray, latestSupportIndex)

            if na(oldLast) or (not na(newLast) and newLast > oldLast)
                array.set(supportLastTestBarArray, mergeSupportIndex, newLast)
                array.set(supportLastTestTypeArray, mergeSupportIndex, array.get(supportLastTestTypeArray, latestSupportIndex))

            // Maximum penetration
            float oldMaxPenetration = array.get(supportMaxPenetrationArray, mergeSupportIndex)
            float newMaxPenetration = array.get(supportMaxPenetrationArray, latestSupportIndex)
            array.set(supportMaxPenetrationArray, mergeSupportIndex, math.max(oldMaxPenetration, newMaxPenetration))

            // Maximum wick ratio
            float oldWick = array.get(supportMaxWickRatioArray, mergeSupportIndex)
            float newWick = array.get(supportMaxWickRatioArray, latestSupportIndex)
            array.set(supportMaxWickRatioArray, mergeSupportIndex, math.max(oldWick, newWick))

            // Maximum reaction
            float oldReaction = array.get(supportMaxReactionArray, mergeSupportIndex)
            float newReaction = array.get(supportMaxReactionArray, latestSupportIndex)
            array.set(supportMaxReactionArray, mergeSupportIndex, math.max(oldReaction, newReaction))

            int mergedSupportTouches = array.get(supportTouchArray, mergeSupportIndex)
            int mergedSupportRejects = array.get(supportStrongRejectArray, mergeSupportIndex)
            int mergedSupportWeakTouches = math.max(0, mergedSupportTouches - mergedSupportRejects)
            float mergedSupportScore = mergedSupportRejects * 5.0 + mergedSupportWeakTouches * 3.0
            array.set(supportScoreArray, mergeSupportIndex, mergedSupportScore)

            // MERGE APPROACH DIRECTION STATE
            int oldDirection = array.get(supportApproachDirectionArray, mergeSupportIndex)
            int newDirection = array.get(supportApproachDirectionArray, latestSupportIndex)
            int mergedDirection = oldDirection

            if mergedDirection == 0 and newDirection != 0
                mergedDirection := newDirection
            array.set(supportApproachDirectionArray, mergeSupportIndex, mergedDirection)

            // DESTROY ABSORBED ZONE
            // The new zone is completely forgotten.
            // Its Zone ID is destroyed.
            // IMPORTANT:
            // We do NOT touch Institutional arrays here.
            // If the surviving ID is institutional, its memory remains.
            // The newly created zone cannot already be institutional
            // at this point in the lifecycle.
            array.remove(supportZoneIDArray, latestSupportIndex)
            array.remove(supportLowArray, latestSupportIndex)
            array.remove(supportHighArray, latestSupportIndex)
            array.remove(supportOriginArray, latestSupportIndex)
            array.remove(supportBarArray, latestSupportIndex)
            array.remove(supportTouchArray, latestSupportIndex)
            array.remove(prevCandleInsideSupportZoneArray, latestSupportIndex)
            array.remove(supportLastTestBarArray, latestSupportIndex)
            array.remove(supportLastTestTypeArray, latestSupportIndex)
            array.remove(supportStrengthArray, latestSupportIndex)
            array.remove(supportStrongRejectArray, latestSupportIndex)
            array.remove(supportMaxPenetrationArray, latestSupportIndex)
            array.remove(supportMaxWickRatioArray, latestSupportIndex)
            array.remove(supportMaxReactionArray, latestSupportIndex)
            array.remove(supportApproachDirectionArray, latestSupportIndex)
            array.remove(supportOriginTimeArray, latestSupportIndex)
            array.remove(supportScoreArray, latestSupportIndex)
            array.remove(supportESArray, latestSupportIndex)
            array.remove(supportZoneATRArray, latestSupportIndex)

    // INSTITUTIONAL QUALIFICATION (SUPPORT)
    // Institutional zones do not create Dynamic zones.
    // They reference an existing Dynamic S/R zone.
    // Qualification occurs ONLY on 4H.
    // Dynamic S/R owns:
    // - Zone identity
    // - Zone geometry
    // - Dynamic lifecycle
    // Institutional lifecycle owns:
    // - Institutional memory
    // - Institutional score
    // - Institutional strength
    // - Institutional TF memory
    // - Institutional failure memory
    // institutional S/R is not responsible for removing Institutional Zones but Dynamic S/R is.
    bool isInstSupportQualificationTF = timeframe.period == "240"
    bool isInstSupportAvailableOnAllTF = true
    if barstate.isconfirmed and isInstSupportQualificationTF and array.size(supportZoneIDArray) > 0
        for i = 0 to array.size(supportZoneIDArray) -1
            string instSupportZoneID = array.get(supportZoneIDArray,i)
            int existinginstSupportZone = array.indexof(instSupportZoneIDArray, instSupportZoneID)

            if existinginstSupportZone != -1
                continue

            int instSupportTouches = array.get(supportTouchArray, i)
            int instSupportStrongRejects = array.get(supportStrongRejectArray, i)
            float instSupportQualificationScore = 0.0

            instSupportQualificationScore += instSupportStrongRejects * 5

            int instSupportWeakTouches = instSupportTouches - instSupportStrongRejects

            if instSupportWeakTouches > 0
                instSupportQualificationScore += instSupportWeakTouches * 3

            instSupportQualificationScore := math.max(0, math.min(50, instSupportQualificationScore))
            
            bool instQualifiedSupport = instSupportQualificationScore >= 50

            if not instQualifiedSupport
                continue

            array.push(instSupportZoneIDArray, instSupportZoneID)
            array.push(instSupportScoreArray, instSupportQualificationScore)
            array.push(instSupportStrengthArray, 0)
            array.push(instQualifiedSupportTFListArray, ",240:0,")
            array.push(instSupportFailureCountArray, 0)
            array.push(InstSupportBreakBarArray, na)

    // INSTITUTIONAL LIFECYCLE — OWNERSHIP CONTRACT (SUPPORT)
    // Institutional SCORE is separate from Institutional STRENGTH.
    // Institutional memory references an existing Dynamic Zone ID.
    // Institutional zones do not own Dynamic Zone identity.
    // The Zone ID is globally unique.
    // We do NOT create another Dynamic zone on the current TF.
    // We do NOT search for a separate "owner".
    // We simply use the Institutional Zone ID to retrieve the
    // corresponding Dynamic zone geometry from Dynamic S/R memory.
    // Dynamic S/R remains the sole owner of the actual zone.
    // SCORE uses the existing Dynamic S/R information:
    // - Dynamic touches
    // - Dynamic strong rejections
    // - Institutional failure count
    // SCORE is maintained in:
    //     instSupportScoreArray
    // FAILURE MEMORY is maintained in:
    //     instSupportFailureCountArray
    // STRENGTH is NOT calculated here.
    // TF strength will be handled separately.
    // The Institutional lifecycle reads that Dynamic failure and
    // records it in instSupportFailureCountArray.
    // Dynamic lifecycle MUST NOT write to Institutional arrays.
    if barstate.isconfirmed and array.size(instSupportZoneIDArray) > 0
        for i = 0 to array.size(instSupportZoneIDArray) - 1
            string instSupportZoneID = array.get(instSupportZoneIDArray, i)
            int dynamicSupportIndex = array.indexof(supportZoneIDArray, instSupportZoneID)

            if dynamicSupportIndex == -1
                continue
            
            int instSupportfailureCount = array.get(instSupportFailureCountArray, i)

            // REACTION SCORE UPDATE
            int instSupportTouches = array.get(supportTouchArray, dynamicSupportIndex)
            int instSupportStrongRejects = array.get(supportStrongRejectArray, dynamicSupportIndex)
            float instSupportReactionScore = 0.0

            instSupportReactionScore += instSupportStrongRejects * 5

            int instSupportWeakTouches = instSupportTouches - instSupportStrongRejects
            if instSupportWeakTouches > 0
                instSupportReactionScore += instSupportWeakTouches * 3

            float instSupportfailureScore = instSupportfailureCount * 5
            float instSupportFinalScore = instSupportReactionScore - instSupportfailureScore
            array.set(instSupportScoreArray, i, instSupportFinalScore)

            // Nearest Institutional Support
            // Search ALL Institutional Support zones.
            // Do not restrict the search by srZoneDistanceATR.
            // For support, only zones below current price are considered.
            // The closest valid institutional support is selected.
            float dynamicSupportLow = array.get(supportLowArray, dynamicSupportIndex)
            float dynamicSupportHigh = array.get(supportHighArray, dynamicSupportIndex)
            bool validInstSupport = dynamicSupportHigh <= c
            if not validInstSupport
                continue

            float instSupportDistanceATR = (c - dynamicSupportHigh) / atr
            float instSupportES = array.get(supportESArray, dynamicSupportIndex)

            if na(nearestInstSupportDistanceATR) or instSupportDistanceATR < nearestInstSupportDistanceATR
                nearestInstSupportDistanceATR := instSupportDistanceATR
                nearestInstSupport := dynamicSupportHigh
                nearestInstSupportScore := array.get(instSupportScoreArray, i)
                nearestInstSupportStrength := array.get(instSupportStrengthArray, i)
                nearestInstSupportZoneID := instSupportZoneID
                nearestInstSupportES := instSupportES
                int lastTestBar = array.get(supportLastTestBarArray, dynamicSupportIndex)
                nearestInstSupportLastTestAge := not na(lastTestBar) ? bar_index - lastTestBar : na
                nearestInstSupportLastTestType := array.get(supportLastTestTypeArray, dynamicSupportIndex)

            // INSTITUTIONAL TIMEFRAME OBSERVATION — SUPPORT
            // Purpose:
            // Detect when an existing Institutional Support zone is
            // interacted with by an eligible timeframe.
            // - No Dynamic zone is created.
            // - No Institutional zone is created.
            // - No score is changed here.
            // - No strength is changed here.
            // - No new arrays are created.
            // The existing Dynamic zone provides:
            // - Zone geometry
            // - Touch/reaction state
            // - Last interaction bar
            // - Interaction type
            // - Failure state
            // This layer only records that the timeframe has observed
            // the existing Institutional zone.
            // Memory: instQualifiedSupportTFListArray
            // Example: ,240:0,1D:0,1W:0,1M:0,
            float instSupportZoneLow = array.get(supportLowArray, dynamicSupportIndex)
            float instSupportZoneHigh = array.get(supportHighArray, dynamicSupportIndex)
            int instSupportZoneBar = array.get(supportBarArray, dynamicSupportIndex)
            string instQualifiedSupportTFList = array.get(instQualifiedSupportTFListArray, i)
            string currentInstSupportTFTag = timeframe.period
            bool isInstSupportObservationTF =
                 currentInstSupportTFTag == "240" or
                 currentInstSupportTFTag == "1D" or
                 currentInstSupportTFTag == "1W" or
                 currentInstSupportTFTag == "1M"

            if not isInstSupportObservationTF
                continue

            string currentSupportTFToken = "," + currentInstSupportTFTag + ":"
            
            bool instSupportZoneInCurrentTF =
                 time > array.get(supportOriginTimeArray, dynamicSupportIndex) and
                 l <= instSupportZoneHigh and
                 h >= instSupportZoneLow

            bool currentSupportTFAlreadyStored = str.contains(instQualifiedSupportTFList, currentSupportTFToken)

            if barstate.isconfirmed and instSupportZoneInCurrentTF and not currentSupportTFAlreadyStored
                instQualifiedSupportTFList += currentInstSupportTFTag + ":0,"
                array.set(instQualifiedSupportTFListArray, i, instQualifiedSupportTFList)

            float interactionWeight = 0.0
            float rejectionWeight = 0.0
            float failureWeight = 0.0

            if currentInstSupportTFTag == "240"
                interactionWeight := 1.0
                rejectionWeight := 2.0
                failureWeight := -2.0

            else if currentInstSupportTFTag == "1D"
                interactionWeight := 6.0
                rejectionWeight := 12.0
                failureWeight := -12.0

            else if currentInstSupportTFTag == "1W"
                interactionWeight := 42.0
                rejectionWeight := 84.0
                failureWeight := -84.0

            else if currentInstSupportTFTag == "1M"
                interactionWeight := 180.0
                rejectionWeight := 360.0
                failureWeight := -360.0

            int currentTokenPosition = str.pos(instQualifiedSupportTFList, currentSupportTFToken)
            float currentTFStrength = 0.0

            if currentTokenPosition != -1
                int currentValueStart = currentTokenPosition + str.length(currentSupportTFToken)
                string remainingTFString = str.substring(instQualifiedSupportTFList, currentValueStart)
                int commaPosition = str.pos(remainingTFString, ",")

                if commaPosition != -1
                    string currentTFValueString = str.substring(remainingTFString, 0, commaPosition)
                    float parsedCurrentTFStrength = str.tonumber(currentTFValueString)

                    if not na(parsedCurrentTFStrength)
                        currentTFStrength := parsedCurrentTFStrength
            int dynamicLastTestBar = array.get(supportLastTestBarArray, dynamicSupportIndex)
            string dynamicLastTestType = array.get(supportLastTestTypeArray, dynamicSupportIndex)
            int dynamicBreakBar = array.get(InstSupportBreakBarArray, i)
            float eventDelta = 0.0

            if not na(dynamicBreakBar) and dynamicBreakBar == bar_index
                eventDelta := failureWeight

            else if not na(dynamicLastTestBar) and dynamicLastTestBar == bar_index

                if dynamicLastTestType == "STRONG_REJECTION"
                    eventDelta := rejectionWeight

                else if dynamicLastTestType == "WEAK_REACTION"
                    eventDelta := interactionWeight

            if eventDelta != 0
                float newTFStrength = currentTFStrength + eventDelta

                // Make sure the timeframe token exists.
                if currentTokenPosition == -1
                    instQualifiedSupportTFList += currentInstSupportTFTag + ":" + str.tostring(newTFStrength) + ","

                else
                    int valueStart = currentTokenPosition + str.length(currentSupportTFToken)
                    string remainingTFString = str.substring(instQualifiedSupportTFList, valueStart)
                    int commaPosition = str.pos(remainingTFString, ",")

                    if commaPosition != -1
                        int tokenEnd = valueStart + commaPosition

                        instQualifiedSupportTFList := str.substring(instQualifiedSupportTFList, 0, valueStart) +
                             str.tostring(newTFStrength) +
                             str.substring(instQualifiedSupportTFList, tokenEnd)

                // Total Institutional strength.
                int currentTotalStrength = array.get(instSupportStrengthArray, i)

                array.set(instSupportStrengthArray, i, currentTotalStrength + int(eventDelta))
                array.set(instQualifiedSupportTFListArray, i, instQualifiedSupportTFList)

        nearInstSupport := nearestInstSupportES > 0 and nearestInstSupportDistanceATR <= srZoneDistanceATR

    // SUPPORT EVIDENCE BENCHMARKS
    // DYNAMIC SUPPORT — EXCLUDING INSTITUTIONAL ZONES
    float dynamicSupportScoreSum = 0.0
    float dynamicSupportESSum = 0.0
    int dynamicSupportCount = 0
    float dynamicSupportLastTestAgeSum = 0.0
    float minDynamicSupportLastTestAge = na
    float maxDynamicSupportLastTestAge = na
    int dynamicSupportLastTestAgeCount = 0
    float minDynamicSupportES = na
    float maxDynamicSupportES = na
    int minDynamicSupportWeakTouches = na
    int maxDynamicSupportWeakTouches = na
    int minDynamicSupportStrongTouches = na
    int maxDynamicSupportStrongTouches = na
    if array.size(supportScoreArray) > 0
        for i = 0 to array.size(supportScoreArray) - 1
            string zoneID = array.get(supportZoneIDArray, i)
            bool isInstitutionalZone = array.indexof(instSupportZoneIDArray, zoneID) != -1
            if not isInstitutionalZone
                float supportES = array.get(supportESArray, i)
                float supportScore = array.get(supportScoreArray, i)
                float strongTouches = array.get(supportStrongRejectArray, i)
                float totalTouches = array.get(supportTouchArray, i)
                float weakTouches = math.max(0.0, totalTouches - strongTouches)
                dynamicSupportScoreSum += array.get(supportScoreArray, i)
                dynamicSupportESSum += array.get(supportESArray, i)
                dynamicSupportCount += 1
                minDynamicSupportES := na(minDynamicSupportES) ? supportES : math.min(minDynamicSupportES, supportES)
                maxDynamicSupportES := na(maxDynamicSupportES) ? supportES : math.max(maxDynamicSupportES, supportES)
                minDynamicSupportWeakTouches := na(minDynamicSupportWeakTouches) ? int(weakTouches) : math.min(minDynamicSupportWeakTouches, int(weakTouches))
                maxDynamicSupportWeakTouches := na(maxDynamicSupportWeakTouches) ? int(weakTouches) : math.max(maxDynamicSupportWeakTouches, int(weakTouches))
                minDynamicSupportStrongTouches := na(minDynamicSupportStrongTouches) ? int(strongTouches) : math.min(minDynamicSupportStrongTouches, int(strongTouches))
                maxDynamicSupportStrongTouches := na(maxDynamicSupportStrongTouches) ? int(strongTouches) : math.max(maxDynamicSupportStrongTouches, int(strongTouches))

                int lastTestBar = array.get(supportLastTestBarArray, i)
                if not na(lastTestBar)
                    float lastTestAge = math.max(0.0, bar_index - lastTestBar)
                    dynamicSupportLastTestAgeSum += lastTestAge
                    dynamicSupportLastTestAgeCount += 1
                    minDynamicSupportLastTestAge := na(minDynamicSupportLastTestAge) ? lastTestAge : math.min(minDynamicSupportLastTestAge, lastTestAge)
                    maxDynamicSupportLastTestAge := na(maxDynamicSupportLastTestAge) ? lastTestAge : math.max(maxDynamicSupportLastTestAge, lastTestAge)

    averageDynamicSupportScore := dynamicSupportCount > 0 ? dynamicSupportScoreSum / dynamicSupportCount : na
    averageDynamicSupportES := dynamicSupportCount > 0 ? dynamicSupportESSum / dynamicSupportCount : na
    averageDynamicSupportLastTestAge := dynamicSupportLastTestAgeCount > 0 ? dynamicSupportLastTestAgeSum / dynamicSupportLastTestAgeCount : na
    dynamicSupportWTNormalized := normalizeRelative(nearestSupportWeakTouches, minDynamicSupportWeakTouches, maxDynamicSupportWeakTouches, normalizationPower, true)
    dynamicSupportSTNormalized := normalizeRelative(nearestSupportStrongTouches, minDynamicSupportStrongTouches, maxDynamicSupportStrongTouches, normalizationPower, true)
    dynamicSupportESNormalized := normalizeRelative(nearestSupportES, minDynamicSupportES, maxDynamicSupportES, normalizationPower, true)
    dynamicSupportLastTestAgeNormalized := normalizeRelative(nearestSupportLastTestAge, minDynamicSupportLastTestAge, maxDynamicSupportLastTestAge, normalizationPower, false)

    // INSTITUTIONAL SUPPORT
    // Averages
    float instSupportScoreSum = 0.0
    float instSupportESSum = 0.0
    int instSupportCount = 0
    float instSupportLastTestAgeSum = 0.0
    int instSupportLastTestAgeCount = 0
    float minInstSupportLastTestAge = na
    float maxInstSupportLastTestAge = na
    float minInstSupportES = na
    float maxInstSupportES = na
    int minInstSupportWeakTouches = na
    int maxInstSupportWeakTouches = na
    int minInstSupportStrongTouches = na
    int maxInstSupportStrongTouches = na
    int minInstSupportFailures = na
    int maxInstSupportFailures = na
    if array.size(instSupportZoneIDArray) > 0
        for i = 0 to array.size(instSupportZoneIDArray) - 1
            string instZoneID = array.get(instSupportZoneIDArray, i)
            int dynamicIndex = array.indexof(supportZoneIDArray, instZoneID)

            if dynamicIndex != -1
                float supportES = array.get(supportESArray, dynamicIndex)
                float supportScore = array.get(instSupportScoreArray, i)
                float strongTouches = array.get(supportStrongRejectArray, dynamicIndex)
                float totalTouches = array.get(supportTouchArray, dynamicIndex)
                float weakTouches = math.max(0.0, totalTouches - strongTouches)
                float instFailures = array.get(instSupportFailureCountArray, i)
                instSupportScoreSum += array.get(instSupportScoreArray, i)
                instSupportESSum += array.get(supportESArray, dynamicIndex)
                instSupportCount += 1
                minInstSupportES := na(minInstSupportES) ? supportES : math.min(minInstSupportES, supportES)
                maxInstSupportES := na(maxInstSupportES) ? supportES : math.max(maxInstSupportES, supportES)
                minInstSupportWeakTouches := na(minInstSupportWeakTouches) ? int(weakTouches) : math.min(minInstSupportWeakTouches, int(weakTouches))
                maxInstSupportWeakTouches := na(maxInstSupportWeakTouches) ? int(weakTouches) : math.max(maxInstSupportWeakTouches, int(weakTouches))
                minInstSupportStrongTouches := na(minInstSupportStrongTouches) ? int(strongTouches) : math.min(minInstSupportStrongTouches, int(strongTouches))
                maxInstSupportStrongTouches := na(maxInstSupportStrongTouches) ? int(strongTouches) : math.max(maxInstSupportStrongTouches, int(strongTouches))
                minInstSupportStrongTouches := na(minInstSupportFailures) ? int(instFailures) : math.min(minInstSupportFailures, int(instFailures))
                maxInstSupportStrongTouches := na(maxInstSupportFailures) ? int(instFailures) : math.max(maxInstSupportFailures, int(instFailures))

                int lastTestBar = array.get(supportLastTestBarArray, dynamicIndex)
                if not na(lastTestBar)
                    float lastTestAge = math.max(0.0, bar_index - lastTestBar)
                    instSupportLastTestAgeSum += lastTestAge
                    instSupportLastTestAgeCount += 1
                    minInstSupportLastTestAge := na(minInstSupportLastTestAge) ? lastTestAge : math.min(minInstSupportLastTestAge, lastTestAge)
                    maxInstSupportLastTestAge := na(maxInstSupportLastTestAge) ? lastTestAge : math.max(maxInstSupportLastTestAge, lastTestAge)

    averageInstSupportScore := instSupportCount > 0 ? instSupportScoreSum / instSupportCount : na
    averageInstSupportES := instSupportCount > 0 ? instSupportESSum / instSupportCount : na
    averageInstSupportLastTestAge := instSupportLastTestAgeCount > 0 ? instSupportLastTestAgeSum / instSupportLastTestAgeCount : na
    instSupportLastTestAgeNormalized := normalizeRelative(nearestInstSupportLastTestAge, minInstSupportLastTestAge, maxInstSupportLastTestAge, normalizationPower, false)
    instSupportWTNormalized := normalizeRelative(nearestSupportWeakTouches, minInstSupportWeakTouches, maxInstSupportWeakTouches, normalizationPower, true)
    instSupportSTNormalized := normalizeRelative(nearestSupportStrongTouches, minInstSupportStrongTouches, maxInstSupportStrongTouches, normalizationPower, true)
    instSupportFailureNormalized := normalizeRelative(nearestInstSupportFailureCount, minInstSupportFailures, maxInstSupportFailures, normalizationPower, true)
    instSupportESNormalized := normalizeRelative(nearestInstSupportES, minInstSupportES, maxInstSupportES, normalizationPower, true)

    // RESISTANCE ZONES
    // ==================
    // RESISTANCE APPROACH DIRECTION
    if array.size(resistanceLowArray) > 0
        for resistanceZoneI = 0 to array.size(resistanceLowArray) - 1
            float resistanceZoneLow  = array.get(resistanceLowArray, resistanceZoneI)
            float resistanceZoneHigh = array.get(resistanceHighArray, resistanceZoneI)
            bool wasInsideResistanceZone = array.get(prevCandleInsideResistanceZoneArray, resistanceZoneI)
            bool insideResistanceZone = bar_index > array.get(resistanceBarArray, resistanceZoneI) and l <= resistanceZoneHigh and h >= resistanceZoneLow
            int oldDirection = array.get(resistanceApproachDirectionArray, resistanceZoneI)
            int approachDirection = oldDirection

            if barstate.isconfirmed and c < resistanceZoneLow and not insideResistanceZone and not wasInsideResistanceZone
                approachDirection := 1

            array.set(resistanceApproachDirectionArray, resistanceZoneI, approachDirection)

    // RESISTANCE CREATION / IDENTIFICATION
    if barstate.isconfirmed and not na(srPivotHigh) and resistanceReactionATR >= srReactionATR
        float potentialResistanceLow = srPivotHigh - srZoneSize
        float potentialResistanceHigh = srPivotHigh + srZoneSize
        bool insideInstitutionalResistance = false

        if array.size(instResistanceZoneIDArray) > 0
            for instI = 0 to array.size(instResistanceZoneIDArray) - 1
                string instResistanceZoneID = array.get(instResistanceZoneIDArray, instI)
                // The Institutional zone must exist in Dynamic S/R memory.
                int instDynamicIndex = array.indexof(resistanceZoneIDArray, instResistanceZoneID)

                if instDynamicIndex != -1
                    float instResistanceZoneLow = array.get(resistanceLowArray, instDynamicIndex)
                    float instResistanceZoneHigh = array.get(resistanceHighArray, instDynamicIndex)
                    bool institutionalResistanceOverlap = potentialResistanceLow <= instResistanceZoneHigh and potentialResistanceHigh >= instResistanceZoneLow

                    if institutionalResistanceOverlap
                        insideInstitutionalResistance := true
                        break

        // Only create a Dynamic zone when it does not
        // conflict with an existing Institutional zone.
        if not insideInstitutionalResistance
            nextResistanceZoneSequence += 1
            string newResistanceZoneID = zoneTFPrefix + "-R-" + str.tostring(nextResistanceZoneSequence, "000000")
            array.push(resistanceZoneIDArray, newResistanceZoneID)
            array.push(resistanceLowArray, srPivotHigh - srZoneSize)
            array.push(resistanceHighArray, srPivotHigh + srZoneSize)
            array.push(resistanceOriginArray, srPivotHigh)
            array.push(resistanceBarArray, bar_index - srPivotRight)
            array.push(resistanceTouchArray, 0)
            array.push(prevCandleInsideResistanceZoneArray, false)
            array.push(resistanceLastTestBarArray, na)
            array.push(resistanceLastTestTypeArray, "NO_TEST")
            array.push(resistanceStrengthArray, 0)
            array.push(resistanceStrongRejectArray, 0)
            array.push(resistanceMaxPenetrationArray, 0.0)
            array.push(resistanceMaxWickRatioArray, 0.0)
            array.push(resistanceMaxReactionArray, 0.0)
            array.push(resistanceApproachDirectionArray, 0)
            array.push(resistanceOriginTimeArray, time[srPivotRight])
            array.push(resistanceScoreArray, 0.0)
            array.push(resistanceESArray, 0)
            array.push(resistanceZoneATRArray, pivotATR)

    if array.size(resistanceLowArray) > 0
        for i = array.size(resistanceLowArray) - 1 to 0
            float resistanceZoneLow = array.get(resistanceLowArray, i)
            float resistanceZoneHigh = array.get(resistanceHighArray, i)
            float resistanceZoneDistanceATR = atr > 0 ? (c > resistanceZoneHigh ? (c - resistanceZoneHigh) / atr : c < resistanceZoneLow ? (resistanceZoneLow - c) / atr : 0.0) : na
            bool wasInsideResistanceZone = array.get(prevCandleInsideResistanceZoneArray, i)
            bool insideResistanceZone = bar_index > array.get(resistanceBarArray, i) and l <= resistanceZoneHigh and h >= resistanceZoneLow
            if insideResistanceZone
                interactingResistanceZoneId := i
            if barstate.isconfirmed
                array.set(prevCandleInsideResistanceZoneArray, i, insideResistanceZone)

            if resistanceZoneDistanceATR > srZoneDistanceATR and not (wasInsideResistanceZone or insideResistanceZone)
                continue
           
            int resistanceZoneAge = bar_index - array.get(resistanceBarArray, i)
            int lastResistanceTestBar = resistanceLastTestBarArray.get(i)
            int barsSinceResistanceTest = not na(lastResistanceTestBar) ? bar_index - lastResistanceTestBar : resistanceZoneAge
            bool wasApproachedFromBelow = array.get(resistanceApproachDirectionArray, i) == 1
            bool previousCandleCrossedZone = barstate.isconfirmed and h1 > resistanceZoneHigh and l1 < resistanceZoneLow and wasApproachedFromBelow
            bool resistanceInvalid = barstate.isconfirmed and h > resistanceZoneHigh and (wasApproachedFromBelow or previousCandleCrossedZone)
     
            if resistanceInvalid
                string zoneID = array.get(resistanceZoneIDArray, i)
                int instIndex = array.indexof(instResistanceZoneIDArray, zoneID)
                bool isResistanceInstitutional = instIndex != -1

                if not isResistanceInstitutional
                    array.remove(resistanceZoneIDArray, i)
                    array.remove(resistanceLowArray,i)
                    array.remove(resistanceHighArray,i)
                    array.remove(resistanceOriginArray,i)
                    array.remove(resistanceBarArray,i)
                    array.remove(resistanceTouchArray,i)
                    array.remove(prevCandleInsideResistanceZoneArray,i)
                    array.remove(resistanceLastTestBarArray, i)
                    array.remove(resistanceLastTestTypeArray, i)
                    array.remove(resistanceStrengthArray, i)
                    array.remove(resistanceStrongRejectArray, i)
                    array.remove(resistanceMaxPenetrationArray, i)
                    array.remove(resistanceMaxWickRatioArray, i)
                    array.remove(resistanceMaxReactionArray, i)
                    array.remove(resistanceApproachDirectionArray, i)
                    array.remove(resistanceOriginTimeArray, i)
                    array.remove(resistanceScoreArray, i)
                    array.remove(resistanceESArray, i)
                    array.remove(resistanceZoneATRArray, i)

                if isResistanceInstitutional
                    int oldFailureCount = array.get(instResistanceFailureCountArray, instIndex)
                    array.set(InstResistanceBreakBarArray, instIndex, bar_index)
                    array.set(instResistanceFailureCountArray, instIndex, oldFailureCount + 1)
                    array.set(resistanceLastTestBarArray, i, bar_index)
                    array.set(resistanceLastTestTypeArray, i, "FAILED")
                    array.set(resistanceApproachDirectionArray, i, 0)
                    float instResistanceScore = array.get(instResistanceScoreArray, instIndex)

                    if instResistanceScore <= 5
                        // remove institutional memory
                        array.remove(instResistanceZoneIDArray, instIndex)
                        array.remove(instResistanceScoreArray, instIndex)
                        array.remove(instResistanceStrengthArray, instIndex)
                        array.remove(instQualifiedResistanceTFListArray, instIndex)
                        array.remove(instResistanceFailureCountArray, instIndex)
                        array.remove(InstResistanceBreakBarArray, instIndex)

                        // Remove dynamic zone
                        array.remove(resistanceZoneIDArray, i)
                        array.remove(resistanceLowArray,i)
                        array.remove(resistanceHighArray,i)
                        array.remove(resistanceOriginArray,i)
                        array.remove(resistanceBarArray,i)
                        array.remove(resistanceTouchArray,i)
                        array.remove(prevCandleInsideResistanceZoneArray,i)
                        array.remove(resistanceLastTestBarArray, i)
                        array.remove(resistanceLastTestTypeArray, i)
                        array.remove(resistanceStrengthArray, i)
                        array.remove(resistanceStrongRejectArray, i)
                        array.remove(resistanceMaxPenetrationArray, i)
                        array.remove(resistanceMaxWickRatioArray, i)
                        array.remove(resistanceMaxReactionArray, i)
                        array.remove(resistanceApproachDirectionArray, i)
                        array.remove(resistanceOriginTimeArray, i)
                        array.remove(resistanceScoreArray, i)
                        array.remove(resistanceESArray, i)
                        array.remove(resistanceZoneATRArray, i)

            else if barstate.isconfirmed
                int oldResistanceTouches = array.get(resistanceTouchArray, i)
                float oldResistanceStrength = array.get(resistanceStrengthArray, i)
                float resistanceZoneHeight = resistanceZoneHigh - resistanceZoneLow
                float resistancePenetration = math.max(0.0, (h - resistanceZoneLow) / resistanceZoneHeight)
                bool penetrationInsideResistanceZone = h >= resistanceZoneLow and h <= resistanceZoneHigh
                if penetrationInsideResistanceZone
                    float oldMaxPenetration = array.get(resistanceMaxPenetrationArray, i)
                    array.set(resistanceMaxPenetrationArray, i, math.max(oldMaxPenetration, resistancePenetration))

                float wickSize = h > resistanceZoneHigh ? h - resistanceZoneHigh : 0
                float candleRange = h - l
                float wickRatio = candleRange > 0 ? wickSize / candleRange : 0
                float currentResistanceReaction = c < resistanceZoneHigh ? (resistanceZoneHigh - c) / atr : 0
                float oldWick = array.get(resistanceMaxWickRatioArray,i)
                float oldReaction = array.get(resistanceMaxReactionArray,i)

                array.set(resistanceMaxWickRatioArray, i, math.max(oldWick, wickRatio))
                array.set(resistanceMaxReactionArray, i, math.max(oldReaction, currentResistanceReaction))

                bool wickAboveResistance = h > resistanceZoneHigh and c < resistanceZoneLow
                if wasInsideResistanceZone and wasApproachedFromBelow and h < resistanceZoneLow
                    int newResistanceTouches = oldResistanceTouches + 1
                    array.set(resistanceTouchArray, i, newResistanceTouches)
                    int strongResistanceRejects = array.get(resistanceStrongRejectArray, i)
                    float currentResistanceStrength = oldResistanceStrength

                    if currentResistanceReaction >= srReactionATR
                        currentResistanceStrength += 5
                        strongResistanceRejects += 1
                        array.set(resistanceLastTestTypeArray, i, "STRONG_REJECTION")

                    else
                        currentResistanceStrength += 3
                        array.set(resistanceLastTestTypeArray, i, "WEAK_REACTION")

                    array.set(resistanceStrengthArray, i, currentResistanceStrength)
                    array.set(resistanceStrongRejectArray, i, strongResistanceRejects)
                    array.set(resistanceLastTestBarArray, i, bar_index)

                // Score
                int resistanceTouches = array.get(resistanceTouchArray, i)
                int strongResistanceRejects = array.get(resistanceStrongRejectArray, i)
                int weakResistanceTouches = math.max(0, resistanceTouches - strongResistanceRejects)
                float resistanceScore = strongResistanceRejects * 5.0 + weakResistanceTouches * 3.0
                array.set(resistanceScoreArray, i, resistanceScore)
    
                float resistanceAgeFactor = 1 / (1 + resistanceZoneAge / 1000)
                float resistanceRecentTestFactor = 1 / (1 + barsSinceResistanceTest / 500)
                string lastResistanceTestType = array.get(resistanceLastTestTypeArray, i)
                float resistanceTestTypeFactor = 0.0

                if lastResistanceTestType == "STRONG_REJECTION"
                    resistanceTestTypeFactor := 1.0
                else if lastResistanceTestType == "WEAK_REACTION"
                    resistanceTestTypeFactor := 0.5
                else if lastResistanceTestType == "FAILED"
                    resistanceTestTypeFactor := -1.0
                else
                    resistanceTestTypeFactor := 0.0

                float effectiveResistanceStrength = 0.0
                string currentResistanceZoneID = array.get(resistanceZoneIDArray, i)
                int instResistanceIndex = array.indexof(instResistanceZoneIDArray, currentResistanceZoneID)
                if instResistanceIndex != -1
                    effectiveResistanceStrength := array.get(instResistanceStrengthArray, instResistanceIndex) * resistanceAgeFactor * resistanceRecentTestFactor * resistanceTestTypeFactor

                else
                    effectiveResistanceStrength := array.get(resistanceStrengthArray, i) * resistanceAgeFactor * resistanceRecentTestFactor * resistanceTestTypeFactor
                array.set(resistanceESArray, i, effectiveResistanceStrength)

                float resistanceDistanceATR = atr > 0 ? (resistanceZoneLow - c) / atr : na
                if wasApproachedFromBelow and resistanceDistanceATR >= 0
                    if na(nearestResistanceDistance) or resistanceDistanceATR < nearestResistanceDistance
                        nearestResistanceDistance := resistanceDistanceATR
                        nearestResistancePrice := resistanceZoneLow
                        nearestResistanceStrength := array.get(resistanceStrengthArray, i)
                        nearestResistanceScore := array.get(resistanceScoreArray, i)
                        nearestResistanceZoneID := array.get(resistanceZoneIDArray, i)
                        nearestResistanceState := array.get(resistanceLastTestTypeArray, i)

                array.set(prevCandleInsideResistanceZoneArray, i, insideResistanceZone)

                float resistanceDistancePrice = na

                if c <= resistanceZoneHigh
                    resistanceDistancePrice := resistanceZoneHigh - c

                if not na(resistanceDistancePrice)
                    if na(nearestResistanceZonePriceDistance) or resistanceDistancePrice < nearestResistanceZonePriceDistance
                        nearestResistanceZonePrice := resistanceZoneHigh
                        nearestResistanceZonePriceID := array.get(resistanceZoneIDArray, i)
                        nearestResistanceZonePriceDistance := resistanceDistancePrice
                        nearestResistanceZonePriceATR :=  array.get(resistanceZoneATRArray, i)
                        nearestResistanceES := array.get(resistanceESArray, i)
                        
                        int lastTestBar = array.get(resistanceLastTestBarArray, i)
                        nearestResistanceLastTestAge := not na(lastTestBar) ? bar_index - lastTestBar : na
                        nearestResistanceLastTestType := array.get(resistanceLastTestTypeArray, i)
                        nearestResistanceStrongTouches := array.get(resistanceStrongRejectArray, i)

                        int nearestResistanceTotalTouches = array.get(resistanceTouchArray, i)
                        nearestResistanceWeakTouches := math.max(0, nearestResistanceTotalTouches - nearestResistanceStrongTouches)

                        int instNearestResistanceIndex = array.indexof(instResistanceZoneIDArray, nearestResistanceZonePriceID)
                        nearestInstResistanceFailureCount := instNearestResistanceIndex != -1 ? array.get(instResistanceFailureCountArray, instNearestResistanceIndex) : na

    // RESISTANCE MERGE
    // Dynamic zones merge only when the newly created zone
    // overlaps / comes sufficiently close to an existing zone.
    // CONTRACT:
    // - Existing older zone survives.
    // - Older Zone ID remains authoritative.
    // - New Zone ID is destroyed after successful merge.
    // - No new Zone ID is created.
    // - Dynamic merge does NOT modify Institutional arrays.
    // - If the surviving Zone ID is institutional, its institutional
    //   memory automatically continues to reference that same ID.
    // - Surviving zone keeps its original height.
    // - Current ATR does NOT resize an existing zone.
    // Institutional zones are not created by this merge.
    // A newly created zone is normal at creation time.
    if barstate.isconfirmed and not na(srPivotHigh) and array.size(resistanceLowArray) > 1
        int latestResistanceIndex = array.size(resistanceLowArray) - 1
        string latestResistanceZoneID = array.get(resistanceZoneIDArray, latestResistanceIndex)
        float newResistanceLow = array.get(resistanceLowArray, latestResistanceIndex)
        float newResistanceHigh = array.get(resistanceHighArray, latestResistanceIndex)
        // Find the nearest existing zone that overlaps
        // or falls within the configured merge distance.
        int mergeResistanceIndex = -1
        float nearestResistanceMergeDistance = na
        for i = 0 to latestResistanceIndex -1
            string existingResistanceZoneID = array.get(resistanceZoneIDArray, i)
            bool existingZoneIsInstitutional = array.indexof(instResistanceZoneIDArray, existingResistanceZoneID) != -1
            if existingZoneIsInstitutional
                continue

            float existingResistanceLow = array.get(resistanceLowArray,i)
            float existingResistanceHigh =array.get(resistanceHighArray,i)
            float mergeResistanceDistance = 0.0
            if newResistanceLow > existingResistanceHigh
                mergeResistanceDistance := newResistanceLow - existingResistanceHigh

            else if newResistanceHigh < existingResistanceLow
                mergeResistanceDistance := existingResistanceLow - newResistanceHigh
            else
                mergeResistanceDistance := 0.0

            bool resistanceOverlap = mergeResistanceDistance <= srMergeDistance
            if resistanceOverlap
                if na(nearestResistanceMergeDistance) or mergeResistanceDistance < nearestResistanceMergeDistance
                    nearestResistanceMergeDistance := mergeResistanceDistance
                    mergeResistanceIndex := i
        
        // Merge only when a valid existing zone was found.
        if mergeResistanceIndex != -1
            float existingResistanceLow = array.get(resistanceLowArray, mergeResistanceIndex)
            float existingResistanceHigh =array.get(resistanceHighArray, mergeResistanceIndex)
            float survivingZoneHeight = existingResistanceHigh - existingResistanceLow
            string survivingResistanceZoneID = array.get(resistanceZoneIDArray, mergeResistanceIndex)
            float combinedLow = math.min(existingResistanceLow, newResistanceLow)
            float combinedHigh = math.max(existingResistanceHigh, newResistanceHigh)
            float mergedCenter = (combinedLow + combinedHigh) / 2.0
            float mergedLow = mergedCenter - survivingZoneHeight / 2.0
            float mergedHigh = mergedCenter + survivingZoneHeight / 2.0

            array.set(resistanceLowArray, mergeResistanceIndex, mergedLow)
            array.set(resistanceHighArray, mergeResistanceIndex, mergedHigh)

            // Keep oldest origin
            int oldBar = array.get(resistanceBarArray, mergeResistanceIndex)
            int newBar = array.get(resistanceBarArray, latestResistanceIndex)

            if newBar < oldBar
                array.set(resistanceBarArray, mergeResistanceIndex, newBar)
                array.set(resistanceOriginArray, mergeResistanceIndex, array.get(resistanceOriginArray, latestResistanceIndex))
                array.set(resistanceOriginTimeArray, mergeResistanceIndex, array.get(resistanceOriginTimeArray, latestResistanceIndex))
                array.set(resistanceZoneATRArray, mergeResistanceIndex, array.get(resistanceZoneATRArray, latestResistanceIndex))

            // Merge touches
            int oldResistanceTouches = array.get(resistanceTouchArray, mergeResistanceIndex)
            int newResistanceTouches = array.get(resistanceTouchArray, latestResistanceIndex)
            array.set(resistanceTouchArray, mergeResistanceIndex, oldResistanceTouches + newResistanceTouches)

            // MERGE STRENGTH MEMORY
            float oldStrength = array.get(resistanceStrengthArray, mergeResistanceIndex)
            float newStrength = array.get(resistanceStrengthArray, latestResistanceIndex)
            array.set(resistanceStrengthArray, mergeResistanceIndex, math.max(oldStrength, newStrength))

            // MERGE effective STRENGTH MEMORY
            float oldES = array.get(resistanceESArray, mergeResistanceIndex)
            float newES = array.get(resistanceESArray, latestResistanceIndex)

            array.set(resistanceESArray, mergeResistanceIndex, math.max(oldES, newES))
            
            // MERGE REJECTION MEMORY
            int oldReject = array.get(resistanceStrongRejectArray, mergeResistanceIndex)
            int newReject = array.get(resistanceStrongRejectArray, latestResistanceIndex)
            array.set(resistanceStrongRejectArray, mergeResistanceIndex, oldReject + newReject)

            // MERGE LAST INTERACTION
            int oldLast = array.get(resistanceLastTestBarArray, mergeResistanceIndex)
            int newLast = array.get(resistanceLastTestBarArray, latestResistanceIndex)
            if na(oldLast) or (not na(newLast) and newLast > oldLast)
                array.set(resistanceLastTestBarArray, mergeResistanceIndex, newLast)
                array.set(resistanceLastTestTypeArray, mergeResistanceIndex, array.get(resistanceLastTestTypeArray, latestResistanceIndex))

            // Maximum penetration
            float oldMaxPenetration = array.get(resistanceMaxPenetrationArray, mergeResistanceIndex)
            float newMaxPenetration = array.get(resistanceMaxPenetrationArray, latestResistanceIndex)
            array.set(resistanceMaxPenetrationArray, mergeResistanceIndex, math.max(oldMaxPenetration, newMaxPenetration))

            // Maximum wick ratio
            float oldWick = array.get(resistanceMaxWickRatioArray, mergeResistanceIndex)
            float newWick = array.get(resistanceMaxWickRatioArray, latestResistanceIndex)
            array.set(resistanceMaxWickRatioArray, mergeResistanceIndex, math.max(oldWick, newWick))

            // Score
            int mergedResistanceTouches = array.get(resistanceTouchArray, mergeResistanceIndex)
            int mergedResistanceRejects = array.get(resistanceStrongRejectArray, mergeResistanceIndex)
            int mergedResistanceWeakTouches = math.max(0, mergedResistanceTouches - mergedResistanceRejects)
            float mergedResistanceScore = mergedResistanceRejects * 5.0 + mergedResistanceWeakTouches * 3.0
            array.set(resistanceScoreArray, mergeResistanceIndex, mergedResistanceScore)

            // Maximum reaction
            float oldReaction = array.get(resistanceMaxReactionArray, mergeResistanceIndex)
            float newReaction = array.get(resistanceMaxReactionArray, latestResistanceIndex)
            array.set(resistanceMaxReactionArray, mergeResistanceIndex, math.max(oldReaction, newReaction))

            // MERGE APPROACH DIRECTION STATE
            int oldDirection = array.get(resistanceApproachDirectionArray, mergeResistanceIndex)
            int newDirection = array.get(resistanceApproachDirectionArray, latestResistanceIndex)
            int mergedDirection = oldDirection

            if mergedDirection == 0 and newDirection != 0
                mergedDirection := newDirection
            array.set(resistanceApproachDirectionArray, mergeResistanceIndex, mergedDirection)

            // DESTROY ABSORBED ZONE
            // The new zone is completely forgotten.
            // Its Zone ID is destroyed.
            // IMPORTANT:
            // We do NOT touch Institutional arrays here.
            // If the surviving ID is institutional, its memory remains.
            // The newly created zone cannot already be institutional
            // at this point in the lifecycle.
            array.remove(resistanceZoneIDArray, latestResistanceIndex)
            array.remove(resistanceLowArray, latestResistanceIndex)
            array.remove(resistanceHighArray, latestResistanceIndex)
            array.remove(resistanceOriginArray, latestResistanceIndex)
            array.remove(resistanceBarArray, latestResistanceIndex)
            array.remove(resistanceTouchArray, latestResistanceIndex)
            array.remove(prevCandleInsideResistanceZoneArray, latestResistanceIndex)
            array.remove(resistanceLastTestBarArray, latestResistanceIndex)
            array.remove(resistanceLastTestTypeArray, latestResistanceIndex)
            array.remove(resistanceStrengthArray, latestResistanceIndex)
            array.remove(resistanceStrongRejectArray, latestResistanceIndex)
            array.remove(resistanceMaxPenetrationArray, latestResistanceIndex)
            array.remove(resistanceMaxWickRatioArray, latestResistanceIndex)
            array.remove(resistanceMaxReactionArray, latestResistanceIndex)
            array.remove(resistanceApproachDirectionArray, latestResistanceIndex)
            array.remove(resistanceOriginTimeArray, latestResistanceIndex)
            array.remove(resistanceScoreArray, latestResistanceIndex)
            array.remove(resistanceESArray, latestResistanceIndex)
            array.remove(resistanceZoneATRArray, latestResistanceIndex)

    // INSTITUTIONAL QUALIFICATION (RESISTANCE)
    // Institutional zones do not create Dynamic zones.
    // They reference an existing Dynamic S/R zone.
    // Qualification occurs ONLY on 4H.
    // Dynamic S/R owns:
    // - Zone identity
    // - Zone geometry
    // - Dynamic lifecycle
    // Institutional lifecycle owns:
    // - Institutional memory
    // - Institutional score
    // - Institutional strength
    // - Institutional TF memory
    // - Institutional failure memory
    // institutional S/R is not responsible for removing Institutional Zones but Dynamic S/R is.
    bool isInstResistanceQualificationTF = timeframe.period == "240"
    bool isInstResistanceAvailableOnAllTF = true
    if barstate.isconfirmed and isInstResistanceQualificationTF and array.size(resistanceZoneIDArray) > 0
        for i = 0 to array.size(resistanceZoneIDArray) -1
            string instResistanceZoneID = array.get(resistanceZoneIDArray,i)
            int existinginstResistanceZone = array.indexof(instResistanceZoneIDArray, instResistanceZoneID)

            if existinginstResistanceZone != -1
                continue

            int instResistanceTouches = array.get(resistanceTouchArray, i)
            int instResistanceStrongRejects = array.get(resistanceStrongRejectArray, i)
            float instResistanceQualificationScore = 0.0

            instResistanceQualificationScore += instResistanceStrongRejects * 5

            int instResistanceWeakTouches = instResistanceTouches - instResistanceStrongRejects

            if instResistanceWeakTouches > 0
                instResistanceQualificationScore += instResistanceWeakTouches * 3

            instResistanceQualificationScore := math.max(0, math.min(50, instResistanceQualificationScore))
            
            bool instQualifiedResistance = instResistanceQualificationScore >= 50

            if not instQualifiedResistance
                continue

            array.push(instResistanceZoneIDArray, instResistanceZoneID)
            array.push(instResistanceScoreArray, instResistanceQualificationScore)
            array.push(instResistanceStrengthArray, 0)
            array.push(instQualifiedResistanceTFListArray, ",240:0,")
            array.push(instResistanceFailureCountArray, 0)
            array.push(InstResistanceBreakBarArray, na)

    // INSTITUTIONAL LIFECYCLE — OWNERSHIP CONTRACT (RESISTANCE)
    // Institutional SCORE is separate from Institutional STRENGTH.
    // Institutional memory references an existing Dynamic Zone ID.
    // Institutional zones do not own Dynamic Zone identity.
    // The Zone ID is globally unique.
    // We do NOT create another Dynamic zone on the current TF.
    // We do NOT search for a separate "owner".
    // We simply use the Institutional Zone ID to retrieve the
    // corresponding Dynamic zone geometry from Dynamic S/R memory.
    // Dynamic S/R remains the sole owner of the actual zone.
    // SCORE uses the existing Dynamic S/R information:
    // - Dynamic touches
    // - Dynamic strong rejections
    // - Institutional failure count
    // SCORE is maintained in:
    //     instResistanceScoreArray
    // FAILURE MEMORY is maintained in:
    //     instResistanceFailureCountArray
    // STRENGTH is NOT calculated here.
    // TF strength will be handled separately.
    // The Institutional lifecycle reads that Dynamic failure and
    // records it in instResistanceFailureCountArray.
    if barstate.isconfirmed and array.size(instResistanceZoneIDArray) > 0
        for i = 0 to array.size(instResistanceZoneIDArray) - 1
            string instResistanceZoneID = array.get(instResistanceZoneIDArray, i)
            int dynamicResistanceIndex = array.indexof(resistanceZoneIDArray, instResistanceZoneID)

            if dynamicResistanceIndex == -1
                continue
            
            int instResistancefailureCount = array.get(instResistanceFailureCountArray, i)

            // REACTION SCORE UPDATE
            int instResistanceTouches = array.get(resistanceTouchArray, dynamicResistanceIndex)
            int instResistanceStrongRejects = array.get(resistanceStrongRejectArray, dynamicResistanceIndex)
            float instResistanceReactionScore = 0.0

            instResistanceReactionScore += instResistanceStrongRejects * 5

            int instResistanceWeakTouches = instResistanceTouches - instResistanceStrongRejects
            if instResistanceWeakTouches > 0
                instResistanceReactionScore += instResistanceWeakTouches * 3

            float instResistancefailureScore = instResistancefailureCount * 5
            float instResistanceFinalScore = instResistanceReactionScore - instResistancefailureScore
            array.set(instResistanceScoreArray, i, instResistanceFinalScore)

            // Nearest Institutional Resistance
            // Search ALL Institutional Resistance zones.
            // Do not restrict the search by srZoneDistanceATR.
            // For resistance, only zones above current price are considered.
            // The closest valid institutional resistance is selected.
            float dynamicResistanceLow = array.get(resistanceLowArray, dynamicResistanceIndex)
            float dynamicResistanceHigh = array.get(resistanceHighArray, dynamicResistanceIndex)
            bool validInstResistance = dynamicResistanceLow >= c
            if not validInstResistance
                continue

            float instResistanceDistanceATR = (dynamicResistanceLow - c) / atr
            float instResistanceES = array.get(resistanceESArray, dynamicResistanceIndex)
            if na(nearestInstResistanceDistanceATR) or instResistanceDistanceATR < nearestInstResistanceDistanceATR
                nearestInstResistanceDistanceATR := instResistanceDistanceATR
                nearestInstResistance := dynamicResistanceLow
                nearestInstResistanceScore := array.get(instResistanceScoreArray, i)
                nearestInstResistanceStrength := array.get(instResistanceStrengthArray, i)
                nearestInstResistanceZoneID := instResistanceZoneID
                nearestInstResistanceES := instResistanceES
                int lastTestBar = array.get(resistanceLastTestBarArray, dynamicResistanceIndex)
                nearestInstResistanceLastTestAge := not na(lastTestBar) ? bar_index - lastTestBar : na
                nearestInstResistanceLastTestType := array.get(resistanceLastTestTypeArray, dynamicResistanceIndex)

            // INSTITUTIONAL TIMEFRAME OBSERVATION — RESISTANCE
            // Purpose:
            // Detect when an existing Institutional Resistance zone is
            // interacted with by an eligible timeframe.
            // - No Dynamic zone is created.
            // - No Institutional zone is created.
            // - No score is changed here.
            // - No strength is changed here.
            // - No new arrays are created.
            // The existing Dynamic zone provides:
            // - Zone geometry
            // - Touch/reaction state
            // - Last interaction bar
            // - Interaction type
            // - Failure state
            // This layer only records that the timeframe has observed
            // the existing Institutional zone.
            // Memory: instQualifiedResistanceTFListArray
            // Example: ,240:0,D:0,W:0,M:0,
            float instResistanceZoneLow = array.get(resistanceLowArray, dynamicResistanceIndex)
            float instResistanceZoneHigh = array.get(resistanceHighArray, dynamicResistanceIndex)
            int instResistanceZoneBar = array.get(resistanceBarArray, dynamicResistanceIndex)
            string instQualifiedResistanceTFList = array.get(instQualifiedResistanceTFListArray, i)
            string currentInstResistanceTFTag = timeframe.period
            bool isInstResistanceObservationTF =
                 currentInstResistanceTFTag == "240" or
                 currentInstResistanceTFTag == "1D" or
                 currentInstResistanceTFTag == "1W" or
                 currentInstResistanceTFTag == "1M"

            if not isInstResistanceObservationTF
                continue

            string currentResistanceTFToken = "," + currentInstResistanceTFTag + ":"
            
            bool instResistanceZoneInCurrentTF =
                 time > array.get(resistanceOriginTimeArray, dynamicResistanceIndex) and
                 l <= instResistanceZoneHigh and
                 h >= instResistanceZoneLow

            bool currentResistanceTFAlreadyStored = str.contains(instQualifiedResistanceTFList, currentResistanceTFToken)

            if barstate.isconfirmed and instResistanceZoneInCurrentTF and not currentResistanceTFAlreadyStored
                instQualifiedResistanceTFList += currentInstResistanceTFTag + ":0,"
                array.set(instQualifiedResistanceTFListArray, i, instQualifiedResistanceTFList)

            float interactionWeight = 0.0
            float rejectionWeight = 0.0
            float failureWeight = 0.0

            if currentInstResistanceTFTag == "240"
                interactionWeight := 1.0
                rejectionWeight := 2.0
                failureWeight := -2.0

            else if currentInstResistanceTFTag == "1D"
                interactionWeight := 6.0
                rejectionWeight := 12.0
                failureWeight := -12.0

            else if currentInstResistanceTFTag == "1W"
                interactionWeight := 42.0
                rejectionWeight := 84.0
                failureWeight := -84.0

            else if currentInstResistanceTFTag == "1M"
                interactionWeight := 180.0
                rejectionWeight := 360.0
                failureWeight := -360.0

            int currentTokenPosition = str.pos(instQualifiedResistanceTFList, currentResistanceTFToken)
            float currentTFStrength = 0.0

            if currentTokenPosition != -1
                int currentValueStart = currentTokenPosition + str.length(currentResistanceTFToken)
                string remainingTFString = str.substring(instQualifiedResistanceTFList, currentValueStart)
                int commaPosition = str.pos(remainingTFString, ",")

                if commaPosition != -1
                    string currentTFValueString = str.substring(remainingTFString, 0, commaPosition)
                    float parsedCurrentTFStrength = str.tonumber(currentTFValueString)

                    if not na(parsedCurrentTFStrength)
                        currentTFStrength := parsedCurrentTFStrength
            int dynamicLastTestBar = array.get(resistanceLastTestBarArray, dynamicResistanceIndex)
            string dynamicLastTestType = array.get(resistanceLastTestTypeArray, dynamicResistanceIndex)
            int dynamicBreakBar = array.get(InstResistanceBreakBarArray, i)
            float eventDelta = 0.0

            if not na(dynamicBreakBar) and dynamicBreakBar == bar_index
                eventDelta := failureWeight

            else if not na(dynamicLastTestBar) and dynamicLastTestBar == bar_index

                if dynamicLastTestType == "STRONG_REJECTION"
                    eventDelta := rejectionWeight

                else if dynamicLastTestType == "WEAK_REACTION"
                    eventDelta := interactionWeight

            if eventDelta != 0
                float newTFStrength = currentTFStrength + eventDelta

                // Make sure the timeframe token exists.
                if currentTokenPosition == -1
                    instQualifiedResistanceTFList += currentInstResistanceTFTag + ":" + str.tostring(newTFStrength) + ","

                else
                    int valueStart = currentTokenPosition + str.length(currentResistanceTFToken)
                    string remainingTFString = str.substring(instQualifiedResistanceTFList, valueStart)
                    int commaPosition = str.pos(remainingTFString, ",")

                    if commaPosition != -1
                        int tokenEnd = valueStart + commaPosition

                        instQualifiedResistanceTFList := str.substring(instQualifiedResistanceTFList, 0, valueStart) +
                             str.tostring(newTFStrength) +
                             str.substring(instQualifiedResistanceTFList, tokenEnd)

                // Total Institutional strength.
                int currentTotalStrength = array.get(instResistanceStrengthArray, i)

                array.set(instResistanceStrengthArray, i, currentTotalStrength + int(eventDelta))
                array.set(instQualifiedResistanceTFListArray, i, instQualifiedResistanceTFList)

        nearInstResistance := nearestInstResistanceES > 0 and nearestInstResistanceDistanceATR <= srZoneDistanceATR

    // RESISTANCE EVIDENCE BENCHMARKS
    // DYNAMIC RESISTANCE — EXCLUDING INSTITUTIONAL ZONES
    float dynamicResistanceScoreSum = 0.0
    float dynamicResistanceESSum = 0.0
    float dynamicResistanceLastTestAgeSum = 0.0
