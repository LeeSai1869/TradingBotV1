        else if structureCandidateLowBar > structureCandidateHighBar and not na(structureCandidateLowPrice) and not na(structureCandidateHighBar) and (newLowType == "LL" or newLowType == "EL")
            candidateTransitionLow := structureCandidateLowPrice
