    if qualifiedBearFVG
        array.push(fvgBearLow, bearFVGLow)
        array.push(fvgBearHigh, bearFVGHigh)
        array.push(fvgBearStrength, bearFVGStrength)
        array.push(fvgBearReaction, 0.0)
        array.push(fvgBearStatus, FVG_STATUS_FRESH)
        array.push(fvgBearCreatedBar, bar_index)
        array.push(fvgBearAge, 0)
        array.push(fvgBearReactionCount, 0)
        array.push(fvgBearLastReactionBar, na)
        array.push(fvgBearReactionActive, false)
        array.push(fvgBearLastReactionType, FVG_REACTION_NONE)
        array.push(fvgBearReactionScore, 0)

    // FVG LIFETIME MANAGEMENT
    // Manages the lifecycle of stored FVGs.
    // Responsibilities:
    // • Process active FVG instances
    // • Process only surviving imbalance zones
    // • Later:
    //     - Detect first touch
    //     - Detect rejection
    //     - Detect invalidation
    //     - Update strength
    //     - Update status
    //     - Removal from active memory
    // BULLISH FVG
    if array.size(fvgBullLow) > 0
        for i = array.size(fvgBullLow) - 1 to 0
            float bullLow = array.get(fvgBullLow, i)
            float bullHigh = array.get(fvgBullHigh, i)
            int bullStatus = array.get(fvgBullStatus, i)
            int bullReactionCount = array.get(fvgBullReactionCount, i)
            int bullLastReactionType = array.get(fvgBullLastReactionType, i)
            int bullReactionScore = array.get(fvgBullReactionScore, i)

            // FVG Zone Age
            int bullCreatedBar = array.get(fvgBullCreatedBar, i)
            int bullAge = bar_index - bullCreatedBar
            array.set(fvgBullAge, i, bullAge)

            // PRICE INTERACTION
            if bullAge > 0
                bool bullTouched = l <= bullHigh and h >= bullLow
                int bullReactionType = FVG_REACTION_NONE
                if bullTouched
                    // Price broke completely through the FVG
                    if c < bullLow
                        bullReactionType := FVG_INVALIDATED

                    // Price entered but closed inside the zone
                    else if c >= bullLow and c <= bullHigh
                        bullReactionType := FVG_WEAK_TOUCH

                    // Price entered and closed above the zone
                    else if c > bullHigh
                        bullReactionType := FVG_STRONG_TOUCH

                // PRICE REACTION TO FVG ZONE
                bool bullReactionWasActive = array.get(fvgBullReactionActive, i)
                bool bullReactionActive = bullReactionWasActive
                if (bullReactionType == FVG_WEAK_TOUCH or bullReactionType == FVG_STRONG_TOUCH) and not bullReactionWasActive
                    bullReactionActive := true
                    int bullCount = bullReactionCount + 1
                    array.set(fvgBullReactionCount, i, bullCount)
                    array.set(fvgBullLastReactionBar, i, bar_index)
                    array.set(fvgBullLastReactionType, i, bullReactionType)

                    if bullCount == 1
                        bullStatus := FVG_STATUS_TESTED
                        array.set(fvgBullStatus, i, bullStatus)

                    else if bullCount >= 2
                        bullStatus := FVG_STATUS_DEFENDED
                        array.set(fvgBullStatus, i, bullStatus)

                // Reaction Strength Measurement
                if bullStatus == FVG_STATUS_TESTED or bullStatus == FVG_STATUS_DEFENDED
                    float bullReactionStrength = math.max(0.0, (h - bullHigh) / atr)

                    if bullReactionStrength > array.get(fvgBullReaction, i)
                        array.set(fvgBullReaction, i, bullReactionStrength)

                bool bullReactionComplete = bullReactionActive and o > bullHigh and l > bullHigh and c > bullHigh and h > bullHigh
                if bullReactionComplete
                    bullReactionActive := false
                    array.set(fvgBullReactionActive, i, bullReactionActive)
                    int reactionScore = bullLastReactionType == FVG_WEAK_TOUCH ? 2 : bullLastReactionType == FVG_STRONG_TOUCH ? 3 : 0
                    bullReactionScore += reactionScore

                array.set(fvgBullReactionScore, i, bullReactionScore)

                // FVG INVALIDATION
                if bullReactionType == FVG_INVALIDATED

                    // FAILED FVG CANDIDATE
                    float bullFailedStrength = array.get(fvgBullStrength, i)
                    int bullFailedCreatedBar = array.get(fvgBullCreatedBar, i)

                    // Determine whether this failure should replace failure memory.
                    bool bullFailureWins = false
                    if fvgFailureDirection == 0 or na(fvgFailureBar)
                        bullFailureWins := true
                    else if bar_index > fvgFailureBar
                        bullFailureWins := true
                    else if bar_index == fvgFailureBar
                        // Same-bar tie-break:
                        // 1. Stronger failed FVG wins.
                        // 2. If equal strength, newer-created FVG wins.
                        bullFailureWins := bullFailedStrength > fvgFailureStrength or (bullFailedStrength == fvgFailureStrength and bullFailedCreatedBar > fvgFailureCreatedBar)

                    if bullFailureWins
                        fvgFailureLow := bullLow
                        fvgFailureHigh := bullHigh
                        fvgFailureStrength := array.get(fvgBullStrength, i)
                        fvgFailureDirection := 1
                        fvgFailureBar := bar_index
                        fvgFailureCreatedBar := bullFailedCreatedBar
                        fvgFailureReactionImpact := validATR ? math.max(0.0, (bullLow - c) / atr) : na

                    // Remove active FVG from memory
                    array.remove(fvgBullLow, i)
                    array.remove(fvgBullHigh, i)
                    array.remove(fvgBullStrength, i)
                    array.remove(fvgBullReaction, i)
                    array.remove(fvgBullStatus, i)
                    array.remove(fvgBullCreatedBar, i)
                    array.remove(fvgBullAge, i)
                    array.remove(fvgBullReactionCount, i)
                    array.remove(fvgBullLastReactionBar, i)
                    array.remove(fvgBullReactionActive, i)
                    array.remove(fvgBullLastReactionType, i)
                    array.remove(fvgBullReactionScore, i)


    // BEARISH FVG
    if array.size(fvgBearLow) > 0
        for i = array.size(fvgBearLow) - 1 to 0
            float bearLow = array.get(fvgBearLow, i)
            float bearHigh = array.get(fvgBearHigh, i)
            int bearStatus = array.get(fvgBearStatus, i)
            int bearReactionCount = array.get(fvgBearReactionCount, i)
            int bearLastReactionType = array.get(fvgBearLastReactionType, i)
            int bearReactionScore = array.get(fvgBearReactionScore, i)

            // FVG Zone Age
            int bearCreatedBar = array.get(fvgBearCreatedBar, i)
            int bearAge = bar_index - bearCreatedBar
            array.set(fvgBearAge, i, bearAge)

            // PRICE INTERACTION
            if bearAge > 0
                bool bearTouched = l <= bearHigh and h >= bearLow
                int bearReactionType = FVG_REACTION_NONE
                if bearTouched
                    // Price broke completely through the FVG
                    if c > bearHigh
                        bearReactionType := FVG_INVALIDATED

                    // Price entered but closed inside the zone
                    else if c >= bearLow and c <= bearHigh
                        bearReactionType := FVG_WEAK_TOUCH

                    // Price entered and closed below the zone
                    else if c < bearLow
                        bearReactionType := FVG_STRONG_TOUCH

                // PRICE REACTION TO FVG ZONE
                bool bearReactionWasActive = array.get(fvgBearReactionActive, i)
                bool bearReactionActive = bearReactionWasActive

                if (bearReactionType == FVG_WEAK_TOUCH or bearReactionType == FVG_STRONG_TOUCH) and not bearReactionWasActive
                    bearReactionActive := true

                    int bearCount = bearReactionCount + 1
                    array.set(fvgBearReactionCount, i, bearCount)
                    array.set(fvgBearLastReactionBar, i, bar_index)
                    array.set(fvgBearLastReactionType, i, bearReactionType)

                    if bearCount == 1
                        bearStatus := FVG_STATUS_TESTED
                        array.set(fvgBearStatus, i, bearStatus)

                    else if bearCount >= 2
                        bearStatus := FVG_STATUS_DEFENDED
                        array.set(fvgBearStatus, i, bearStatus)

                // Reaction Strength Measurement
                if bearStatus == FVG_STATUS_TESTED or bearStatus == FVG_STATUS_DEFENDED
                    float bearReactionStrength = math.max(0.0, (bearLow - low) / atr)

                    if bearReactionStrength > array.get(fvgBearReaction, i)
                        array.set(fvgBearReaction, i, bearReactionStrength)

                bool bearReactionComplete = bearReactionActive and o < bearLow and l < bearLow and c < bearLow and h < bearLow
                if bearReactionComplete
                    bearReactionActive := false
                    int reactionScore = bearLastReactionType == FVG_WEAK_TOUCH ? 2 : bearLastReactionType == FVG_STRONG_TOUCH ? 3 : 0
                    bearReactionScore += reactionScore
                    array.set(fvgBearReactionScore, i, bearReactionScore)

                array.set(fvgBearReactionActive, i, bearReactionActive)

                // FVG INVALIDATION
                if bearReactionType == FVG_INVALIDATED

                    // FAILED FVG CANDIDATE
                    float bearFailedStrength = array.get(fvgBearStrength, i)
                    int bearFailedCreatedBar = array.get(fvgBearCreatedBar, i)

                    // Determine whether this failure should replace failure memory.
                    bool bearFailureWins = false
                    if fvgFailureDirection == 0 or na(fvgFailureBar)
                        bearFailureWins := true
                    else if bar_index > fvgFailureBar
                        bearFailureWins := true
                    else if bar_index == fvgFailureBar
                        // Same-bar tie-break:
                        // 1. Stronger failed FVG wins.
                        // 2. If equal strength, newer-created FVG wins.
                        bearFailureWins := bearFailedStrength > fvgFailureStrength or (bearFailedStrength == fvgFailureStrength and bearFailedCreatedBar > fvgFailureCreatedBar)

                    if bearFailureWins
                        fvgFailureLow := bearLow
                        fvgFailureHigh := bearHigh
                        fvgFailureStrength := array.get(fvgBearStrength, i)
                        fvgFailureDirection := -1
                        fvgFailureBar := bar_index
                        fvgFailureCreatedBar := bearFailedCreatedBar
                        fvgFailureReactionImpact := validATR ? math.max(0.0, (c - bearHigh) / atr) : na

                    // Remove active FVG from memory
                    array.remove(fvgBearLow, i)
                    array.remove(fvgBearHigh, i)
                    array.remove(fvgBearStrength, i)
                    array.remove(fvgBearReaction, i)
                    array.remove(fvgBearStatus, i)
                    array.remove(fvgBearCreatedBar, i)
                    array.remove(fvgBearAge, i)
                    array.remove(fvgBearReactionCount, i)
                    array.remove(fvgBearLastReactionBar, i)
                    array.remove(fvgBearReactionActive, i)
                    array.remove(fvgBearLastReactionType, i)
                    array.remove(fvgBearReactionScore, i)

    // FVG FAILURE MEMORY CLEANUP
    if fvgFailureDirection != 0 and not na(fvgFailureBar)
        int failureAge = bar_index - fvgFailureBar
        if failureAge > FVG_FAILURE_MEMORY_BARS
            fvgFailureLow := na
            fvgFailureHigh := na
            fvgFailureStrength := na
            fvgFailureDirection := 0
            fvgFailureBar := na
            fvgFailureReactionImpact := na
            fvgFailureCreatedBar := na

    // FVG FEATURE OUTPUT
    // Active FVG availability
    bool hasBullFVG = array.size(fvgBullLow) > 0
    bool hasBearFVG = array.size(fvgBearLow) > 0

    // Bullish FVG Outout
    float nearestBullFVGLow = na
    float nearestBullFVGHigh = na
    float nearestBullFVGStrength = na
    float nearestBullFVGMaxReaction = na
    int nearestBullFVGStatus = FVG_STATUS_NONE
    int nearestBullFVGAge = na
    int nearestBullFVGReactionCount = 0
    float nearestBullFVGDistanceATR = na
    int nearestBullFVGCreatedBar = na
    int nearestbullFVGLastReactionType = na
    int nearestbullFVGReactionScore = na
    float minBullFVGReactionScore = na
    float maxBullFVGReactionScore = na

    if hasBullFVG
        minBullFVGReactionScore := array.min(fvgBullReactionScore)
        maxBullFVGReactionScore := array.max(fvgBullReactionScore)

        for i = array.size(fvgBullLow) - 1 to 0
            float bullLow = array.get(fvgBullLow, i)
            float bullHigh = array.get(fvgBullHigh, i)
            int bullCreatedBar = array.get(fvgBullCreatedBar, i)
            float bullFVGZoneDistanceATR = validATR ? (c > bullHigh ? (c - bullHigh) / atr : c < bullLow ? (bullLow - c) / atr : 0.0) : na
            if not na(bullFVGZoneDistanceATR) and bullFVGZoneDistanceATR <= fvgZoneDistanceATR
                bool bullIsCloser = na(nearestBullFVGDistanceATR) or bullFVGZoneDistanceATR < nearestBullFVGDistanceATR
                bool bullIsTieAndNewer = not na(nearestBullFVGDistanceATR) and bullFVGZoneDistanceATR == nearestBullFVGDistanceATR and bullCreatedBar > nearestBullFVGCreatedBar
                if bullIsCloser or bullIsTieAndNewer
                    nearestBullFVGDistanceATR := bullFVGZoneDistanceATR
                    nearestBullFVGLow := bullLow
                    nearestBullFVGHigh := bullHigh
                    nearestBullFVGStrength := array.get(fvgBullStrength, i)
                    nearestBullFVGMaxReaction := array.get(fvgBullReaction, i)
                    nearestBullFVGStatus := array.get(fvgBullStatus, i)
                    nearestBullFVGAge := array.get(fvgBullAge, i)
                    nearestBullFVGReactionCount := array.get(fvgBullReactionCount, i)
                    nearestBullFVGCreatedBar := bullCreatedBar
                    nearestbullFVGLastReactionType := array.get(fvgBullLastReactionType, i)
                    nearestbullFVGReactionScore := array.get(fvgBullReactionScore, i)

    bool priceInsideBullMemoryFVG = hasBullFVG and l <= nearestBullFVGHigh and h >= nearestBullFVGLow
    bool nearBullMemoryFVG = not na(nearestBullFVGDistanceATR) and nearestBullFVGDistanceATR <= fvgZoneDistanceATR

    if not na(nearestbullFVGReactionScore)
        if maxBullFVGReactionScore > minBullFVGReactionScore
            nearestBullFVGReactionScoreNormalized := normalizeRelative(nearestbullFVGReactionScore, minBullFVGReactionScore, maxBullFVGReactionScore, normalizationPower, true)

    // Bearish FVG Output
    float nearestBearFVGLow = na
    float nearestBearFVGHigh = na
    float nearestBearFVGStrength = na
    float nearestBearFVGMaxReaction = na
    int nearestBearFVGStatus = FVG_STATUS_NONE
    int nearestBearFVGAge = na
    int nearestBearFVGReactionCount = 0
    float nearestBearFVGDistanceATR = na
    int nearestBearFVGCreatedBar = na
    int nearestbearFVGLastReactionType = na
    int nearestbearFVGReactionScore = na
    float minBearFVGReactionScore = na
    float maxBearFVGReactionScore = na

    if hasBearFVG
        minBearFVGReactionScore := array.max(fvgBullReactionScore)
        maxBearFVGReactionScore := array.max(fvgBullReactionScore)

        for i = array.size(fvgBearLow) - 1 to 0
            float bearLow = array.get(fvgBearLow, i)
            float bearHigh = array.get(fvgBearHigh, i)
            int bearCreatedBar = array.get(fvgBearCreatedBar, i)
            float bearFVGZoneDistanceATR = validATR ? (c > bearHigh ? (c - bearHigh) / atr : c < bearLow ? (bearLow - c) / atr : 0.0) : na
            if not na(bearFVGZoneDistanceATR) and bearFVGZoneDistanceATR <= fvgZoneDistanceATR
                bool bearIsCloser = na(nearestBearFVGDistanceATR) or bearFVGZoneDistanceATR < nearestBearFVGDistanceATR
                bool bearIsTieAndNewer = not na(nearestBearFVGDistanceATR) and bearFVGZoneDistanceATR == nearestBearFVGDistanceATR and bearCreatedBar > nearestBearFVGCreatedBar
                if bearIsCloser or bearIsTieAndNewer
                    nearestBearFVGDistanceATR := bearFVGZoneDistanceATR
                    nearestBearFVGLow := bearLow
                    nearestBearFVGHigh := bearHigh
                    nearestBearFVGStrength := array.get(fvgBearStrength, i)
                    nearestBearFVGMaxReaction := array.get(fvgBearReaction, i)
                    nearestBearFVGStatus := array.get(fvgBearStatus, i)
                    nearestBearFVGAge := array.get(fvgBearAge, i)
                    nearestBearFVGReactionCount := array.get(fvgBearReactionCount, i)
                    nearestBearFVGCreatedBar := bearCreatedBar
                    nearestbearFVGLastReactionType := array.get(fvgBearLastReactionType, i)
                    nearestbearFVGReactionScore := array.get(fvgBearReactionScore, i)

    if not na(nearestbearFVGReactionScore)
        if maxBearFVGReactionScore > minBearFVGReactionScore
            nearestBearFVGReactionScoreNormalized := normalizeRelative(nearestbearFVGReactionScore, minBearFVGReactionScore, maxBearFVGReactionScore, normalizationPower, false)

    bool priceInsideBearMemoryFVG = hasBearFVG and l <= nearestBearFVGHigh and h >= nearestBearFVGLow
    bool nearBearMemoryFVG = not na(nearestBearFVGDistanceATR) and nearestBearFVGDistanceATR <= fvgZoneDistanceATR
    bool recentBullFVGFailure = fvgFailureDirection == 1
    bool recentBearFVGFailure = fvgFailureDirection == -1
    int fvgFailureAge = not na(fvgFailureBar) ? bar_index - fvgFailureBar : na

    //=========================
    // 4.2.12 CANDLE FEATURES
    //=========================
    float candleRange = h - l
    float prevCandleRange = h1 - l1
    float body = math.abs(c - o)
    float prevBody = math.abs(c1 - o1)
    float upperWick = h - math.max(c, o)
    float lowerWick = math.min(c, o) - l
    float wickRatio = candleRange > 0 ? upperWick / candleRange : 0.0
    float bodyPercent = candleRange > 0 ? math.abs(c - o) / candleRange : 0
    float closeLocation = candleRange > 0 ? (c - l) / candleRange : 0.5
    float prevCloseLocation = prevCandleRange > 0 ? (c1 - l1) / prevCandleRange : 0.5
    float candleDirection = c - o
    float prevCandleDirection = c1 - o1
    float displacementATR = atr > 0 ? math.abs(c - o) / atr : 0.0
    float prevDisplacementATR = displacementATR[1]
    float directionalDisplacement = atr > 0 ? (c - o) / atr : 0
    float candleEfficiency = candleRange > 0 ? math.abs(c - o) / candleRange : 0
    float pivotHigh = ta.pivothigh(h, srPivotLen, srPivotLen)
    float pivotLow = ta.pivotlow(l, srPivotLen, srPivotLen)
    float prevPivotHigh = ta.valuewhen(not na(pivotHigh), pivotHigh, 1)
    float prevPivotLow = ta.valuewhen(not na(pivotLow), pivotLow, 1)

    float candleRangeATR = 0.0
    if not na(candleRange) and not na(atr) and atr > 0
        candleRangeATR := candleRange / atr

    // Previous Candle features
    bool prevBearCandle = c1 < o1
    bool prevBullCandle = c1 > o1
    float prevBodyPercent = prevCandleRange > 0 ? prevBody / prevCandleRange : 0

    // PRICE ACTION FEATURE CALCULATION
    // Raw candle pattern detection.
    // No scoring.
    // No signal logic.
    // No direction decision.
    // ENGULFING
    //
    // Bullish engulfing:
    // Current candle body completely engulfs previous bearish body.
    // Bearish engulfing:
    // Current candle body completely engulfs previous bullish body.
    bool bullEngulfing = c > o and o <= c1 and c >= o1 and c1 < o1
    bool bearEngulfing = c < o and o >= c1 and c <= o1 and c1 > o1

    // REJECTION CANDLE
    // Measures rejection through wick behaviour.
    // Bull rejection:
    // Long lower wick + bullish close.
    // Bear rejection:
    // Long upper wick + bearish close.
    float currentBody = math.abs(c - o)
    float currentRange = h - l
    bool bullRejection = currentRange > 0 and lowerWick >= currentBody * 1.5 and c > o
    bool bearRejection = currentRange > 0 and upperWick >= currentBody * 1.5 and c < o

    // BREAK / RETEST
    // Uses confirmed previous pivot structure.
    // Break:
    // Price exceeds previous confirmed swing.
    // Retest:
    // After break, price returns toward broken level
    // and closes back in breakout direction.
    // Raw feature only.
    bool bullBreakRetest = not na(prevPivotHigh) and h > prevPivotHigh and l <= prevPivotHigh and c > prevPivotHigh
    bool bearBreakRetest = not na(prevPivotLow) and l < prevPivotLow and h >= prevPivotLow and c < prevPivotLow

    bool bullishDisplacement = c > o
    bool bearishDisplacement = c < o

    //=========================
    // 4.2.13 PRICE CHANGE DATA
    //=========================
    float change = c - c1
    float changePercent = c1 != 0 ? change / c1 : na

    //==================================================
    // 4.2.14 FIBONACCI STRUCTURE ENGINE
    //==================================================
    // Raw Fibonacci reaction levels
    // Provides:
    // - Active Fib range
    // - Fib levels
    // - Price interaction state
    // - No scoring
    // - No signals
    // - No trade interpretation
    // No scoring
    // No signals
    //==================================================
    // FIBONACCI PERSISTENT MEMORY
    var float activeFibHigh = na
    var float activeFibLow = na
    var int activeFibHighBar = na
    var int activeFibLowBar = na
    var string fibDirection = "NONE"

    // New confirmed pivot high
    if not na(pivotHigh)
        if pivotHigh - c >= atr * fibPivotReactionATR
            activeFibHigh := pivotHigh
            activeFibHighBar := bar_index[srPivotLen]

    // New confirmed pivot low
    if not na(pivotLow)
        if c - pivotLow >= atr * fibPivotReactionATR
            activeFibLow := pivotLow
            activeFibLowBar := bar_index[srPivotLen]

    // CONFIRM DIRECTION
    //====================
    if not na(activeFibHighBar) and not na(activeFibLowBar)

    // Bullish impulse:
    // l confirmed first
    // Then h confirmed
        if activeFibLowBar < activeFibHighBar
            fibDirection := "BULLISH_LEG"

    // Bearish impulse:
    // h confirmed first
    // Then l confirmed
        if activeFibHighBar < activeFibLowBar
            fibDirection := "BEARISH_LEG"

    // NEAREST FIB OUTPUT
    float nearestFibPrice = na
    float nearestFibRatio = na
    float nearestFibDistancePct = na
    float nearestFibDistance = na
    
    // FIB EXTENSION
    float currentFibExtensionRatio = na
    float nearestFibExtensionRatio = na
    float nearestFibExtensionPrice = na
    float nearestFibExtensionDistancePct = na
    bool fibExtensionActive = false

    // FIB RANGE
    float fibHigh = activeFibHigh
    float fibLow  = activeFibLow
    float fibRange = not na(activeFibHigh) and not na(activeFibLow) ? math.abs(activeFibHigh - activeFibLow) : na

    // FIB EXTENSIONS
    if not na(fibRange)
        if fibDirection == "BULLISH_LEG"
            if c > activeFibHigh
                fibExtensionActive := true
                currentFibExtensionRatio := 1 + (c - activeFibHigh) / fibRange

        if fibDirection == "BEARISH_LEG"
            if c < activeFibLow
                fibExtensionActive := true
                currentFibExtensionRatio := 1 + (activeFibLow - c) / fibRange

    // FIBONACCI LEVEL GRID
    // FIBONACCI RATIOS
    var float[] fibRetracementRatios = array.from(0.236, 0.382, 0.500, 0.618, 0.786)
    var float[] fibExtensionRatios = array.from(1.000, 1.272, 1.414, 1.618, 2.000, 2.618)

    // CALCULATE FIB GRID
    if not na(fibRange)
        for i = 0 to array.size(fibRetracementRatios) - 1

            float retracementRatio = array.get(fibRetracementRatios, i)
            float levelPrice = na

            if fibDirection == "BULLISH_LEG"
                levelPrice := activeFibHigh - fibRange * retracementRatio

            if fibDirection == "BEARISH_LEG"
                levelPrice := activeFibLow + fibRange * retracementRatio

            float distancePct = not na(levelPrice) ? math.abs(c - levelPrice) / c * 100 : na
            float distancetoFibLevel = not na(levelPrice) ? math.abs(c - levelPrice) : na

            // FIND NEAREST LEVEL
            if not na(distancePct) and (na(nearestFibDistancePct) or distancePct < nearestFibDistancePct)
                nearestFibDistancePct := distancePct
                nearestFibDistance := distancetoFibLevel
                nearestFibPrice := levelPrice
                nearestFibRatio := retracementRatio

    // CALCULATE EXTENSION GRID
    if not na(fibRange) and fibExtensionActive
        for i = 0 to array.size(fibExtensionRatios) - 1
            float extensionRatio = array.get(fibExtensionRatios, i)
            float extensionPrice = na

            if fibDirection == "BULLISH_LEG"
                extensionPrice := activeFibHigh + fibRange * (extensionRatio - 1)

            if fibDirection == "BEARISH_LEG"
                extensionPrice := activeFibLow - fibRange * (extensionRatio - 1)

            float extensionDistancePct = math.abs(c - extensionPrice) / c * 100

            // FIND NEAREST EXTENSION LEVEL
            if not na(extensionDistancePct) and (na(nearestFibExtensionDistancePct) or extensionDistancePct < nearestFibExtensionDistancePct)
                nearestFibExtensionDistancePct := extensionDistancePct
                nearestFibExtensionPrice := extensionPrice
                nearestFibExtensionRatio := extensionRatio

    // Standard retracement prices
    float fib050Price = na
    float fib0618Price = na
    float fib0786Price = na
    bool activeFibRangeValid = not na(activeFibHigh) and not na(activeFibLow) and activeFibHigh > activeFibLow and not na(fibRange) and fibRange > 0

    if activeFibRangeValid
        if fibDirection == "BULLISH_LEG"
            fib050Price  := activeFibHigh - fibRange * 0.500
            fib0618Price := activeFibHigh - fibRange * 0.618
            fib0786Price := activeFibHigh - fibRange * 0.786

        if fibDirection == "BEARISH_LEG"
            fib050Price  := activeFibLow + fibRange * 0.500
            fib0618Price := activeFibLow + fibRange * 0.618
            fib0786Price := activeFibLow + fibRange * 0.786

    //==================================================
    // 4.2.16 LIQUIDITY DETECTION
    //==================================================
    // SweepDetected:
    // - Liquidity event only
    // - Indicates liquidity was taken
    // - No confirmation
    // - Must NOT be used as trade confirmation
    //
    // SweepReclaim / SweepReject:
    // - Confirmed reaction after liquidity event
    // - Valid for price action confirmation
    // - Can be consumed by scoring engines
    //
    // RULE:
    // Location / Context:
    //     bullSweepDetected
    //     bearSweepDetected
    // Confirmation:
    //     bullSweepReclaim
    //     bearSweepReject
    //
    // Never replace confirmation with detection.
    //==================================================
    bool bidAbsorption = false
    bool askAbsorption = false

    float bidAbsorptionStrength = 0.0
    float askAbsorptionStrength = 0.0
    float nearestBuyLiquidityPriceDistance = na
    float nearestBuyLiquidityATRDistance = na
    float nearestSellLiquidityPriceDistance = na
    float nearestSellLiquidityATRDistance = na

    // Recent swing liquidity
    float recentHighLiquidity = ta.highest(h, liquidityLookback)
    float recentLowLiquidity = ta.lowest(l, liquidityLookback)
    float prevLowLiquidity = ta.lowest(l1, liquidityLookback)
    float prevHighLiquidity = ta.highest(h1, liquidityLookback)

    // Distance from current price
    float liquidityHighDistance = not na(recentHighLiquidity) ? (recentHighLiquidity - c) / c * 100 : na
    float liquidityLowDistance = not na(recentLowLiquidity) ? (c - recentLowLiquidity) / c * 100 : na

    // Equal highs / lows
    bool equalHighLiquidity = math.abs(h - h1) / c < 0.001
    bool equalLowLiquidity = math.abs(l - l1) / c < 0.001

    // LIQUIDITY SWEEP CONTEXT
    //=========================
    // Bullish sweep:
    // Takes sell-side liquidity and reclaims level
    bool bullSweepDetected = l < prevLowLiquidity
    bool bullSweepReclaim = bullSweepDetected and c > recentLowLiquidity[1]

    // Bearish sweep:
    // Takes buy-side liquidity and rejects level
    bool bearSweepDetected = h > prevHighLiquidity
    bool bearSweepReject = bearSweepDetected and c < recentHighLiquidity[1]

    // SWEEP STRENGTH
    float bullSweepStrength = bullSweepDetected ? math.min(math.abs(recentLowLiquidity[1] - l) / atr, 5) : 0
    float bearSweepStrength = bearSweepDetected ? math.min(math.abs(h - recentHighLiquidity[1]) / atr, 5) : 0

    // ABSORPTION
    bool elevatedVolume = not na(volumeMA) and volume >= volumeMA * 1.5
    bool supportInteraction = not na(supportHigh) and l <= supportHigh and c >= supportHigh
    bool resistanceInteraction = not na(resistanceLow) and h >= resistanceLow and c <= resistanceLow
    bool bullishRejection = candleRange > 0 and lowerWick / candleRange >= 0.35 and c > o
    bool bearishRejection = candleRange > 0 and upperWick / candleRange >= 0.35 and c < o

    bidAbsorption := supportInteraction and elevatedVolume and bullishRejection
    askAbsorption := resistanceInteraction and elevatedVolume and bearishRejection

    // ABSORPTION STRENGTH
    bidAbsorptionStrength := 0.0
    askAbsorptionStrength := 0.0

    if bidAbsorption
        bidAbsorptionStrength += math.min(volumeRatio * 20.0, 30.0)
        bidAbsorptionStrength += math.min(wickRatio * 50.0, 30.0)

        if bullSweepDetected
            bidAbsorptionStrength += 20.0

        if bullSweepReclaim
            bidAbsorptionStrength += 20.0

        bidAbsorptionStrength := math.min(bidAbsorptionStrength, 100.0)

    if askAbsorption
        askAbsorptionStrength += math.min(volumeRatio * 20.0, 30.0)
        askAbsorptionStrength += math.min(wickRatio * 50.0, 30.0)

        if bearSweepDetected
            askAbsorptionStrength += 20.0

        if bearSweepReject
            askAbsorptionStrength += 20.0

        askAbsorptionStrength := math.min(askAbsorptionStrength, 100.0)

    // LIQUIDITY TYPE
    string liquidityType =
         equalLowLiquidity and bullSweepDetected ? "SELL_SIDE_EQUAL_LOW" :
         equalHighLiquidity and bearSweepDetected ? "BUY_SIDE_EQUAL_HIGH" :
         bullSweepDetected ? "SELL_SIDE_SWEEP" :
         bearSweepDetected ? "BUY_SIDE_SWEEP" :
         "NONE"

    // LIQUIDITY CONTEXT EXPANSION
    // PURPOSE:
    // Enhance liquidity identification.
    //
    // Detects:
    // - External liquidity pools
    // - Internal liquidity pools
    // - Liquidity clustering
    // - Liquidity age
    // - Liquidity importance
    // INPUTS
    int externalLiquidityLookback = 200
    int internalLiquidityLookback = 50
    float liquidityClusterTolerance = 0.002

    // EXTERNAL LIQUIDITY
    // Major swing liquidity.
    // Used mainly by Swing Engine.
    // Example:
    // Previous weekly/monthly extremes.
    float externalHighLiquidity = ta.highest(h, externalLiquidityLookback)
    float externalLowLiquidity = ta.lowest(l, externalLiquidityLookback)

    // Distance %
    float externalHighDistancePct = not na(externalHighLiquidity) ? math.abs(externalHighLiquidity - c) / c * 100 : na
    float externalHighDistance = not na(externalHighLiquidity) ? math.abs(externalHighLiquidity - c) : na
    float externalLowDistancePct = not na(externalLowLiquidity) ? math.abs(c - externalLowLiquidity) / c * 100 : na
    float externalLowDistance = not na(externalLowLiquidity) ? math.abs(c - externalLowLiquidity) : na

    // INTERNAL LIQUIDITY
    // Short-term resting liquidity.
    float internalHighLiquidity = ta.highest(h, internalLiquidityLookback)
    float internalLowLiquidity = ta.lowest(l, internalLiquidityLookback)
    float internalHighDistancePct = not na(internalHighLiquidity) ? math.abs(internalHighLiquidity - c) / c * 100 : na
    float internalHighDistance = not na(internalHighLiquidity) ? math.abs(internalHighLiquidity - c) : na
    float internalLowDistance = not na(internalLowLiquidity) ? math.abs(c - internalLowLiquidity) / c * 100 : na

    // LIQUIDITY CLUSTER DETECTION
    // Multiple highs/lows around same area.
    // Approximation of heatmap liquidity.
    // Example:
    // High
    // High
    // h   <-- liquidity cluster
    int highClusterCount = 0
    int lowClusterCount  = 0

    for i = 1 to 50
        if math.abs(h[i] - externalHighLiquidity) / c <= liquidityClusterTolerance
            highClusterCount += 1

        if math.abs(l[i] - externalLowLiquidity) / c <= liquidityClusterTolerance
            lowClusterCount += 1

    float highLiquidityClusterScore = math.min(highClusterCount / 3, 5)
    float lowLiquidityClusterScore = math.min(lowClusterCount / 3, 5)
    bool highLiquidityCluster = highLiquidityClusterScore >= 2
    bool lowLiquidityCluster = lowLiquidityClusterScore >= 2

    // LIQUIDITY AGE
    // Older liquidity generally has more importance.
    // Example:
    // 100 bar high
    // >
    // 5 bar high
    int highLiquidityAge = na
    int lowLiquidityAge  = na

    for i = 1 to externalLiquidityLookback
        if na(highLiquidityAge) and math.abs(h[i] - externalHighLiquidity) / c < 0.0005
            highLiquidityAge := i

        if na(lowLiquidityAge) and math.abs(l[i] - externalLowLiquidity) / c < 0.0005
            lowLiquidityAge := i

    // LIQUIDITY IMPORTANCE
    // Generic market fact.
    //
    // Not bullish.
    // Not bearish.
    float highLiquidityImportance = 0.0
    float lowLiquidityImportance  = 0.0

    // Distance factor
    if not na(externalHighDistancePct)
        highLiquidityImportance += math.max(0, 5 - externalHighDistancePct)

    if not na(externalLowDistance)
        lowLiquidityImportance += math.max(0, 5 - externalLowDistancePct)

    float liquidityMaxDistancePct = 5.0

    // Cluster factor
    float liquidityClusterImportance = 2.0

    if highLiquidityCluster
        highLiquidityImportance += liquidityClusterImportance

    if lowLiquidityCluster
        lowLiquidityImportance += liquidityClusterImportance

    // Age factor
    if not na(highLiquidityAge)
        highLiquidityImportance += math.min(highLiquidityAge / 50, 3)

    if not na(lowLiquidityAge)
        lowLiquidityImportance += math.min(lowLiquidityAge / 50, 3)

    // CAP
    highLiquidityImportance := math.min(highLiquidityImportance,10)
    lowLiquidityImportance := math.min(lowLiquidityImportance,10)

    // LIQUIDITY LOCATION TYPE
    string liquidityLocation =
         highLiquidityCluster and lowLiquidityCluster ?
         "BOTH_CLUSTER" :
         highLiquidityCluster ?
         "BUY_SIDE_CLUSTER" :
         lowLiquidityCluster ?
         "SELL_SIDE_CLUSTER" :
         "NO_CLUSTER"

    string liquiditySide = c < externalLowLiquidity ? "SELL_SIDE_NEAR" : c > externalHighLiquidity ? "BUY_SIDE_NEAR" : "MID_RANGE"

    // Nearest Liquidity
    float nearestBuyLiquidityPct = na
    float nearestSellLiquidityPct = na
    float nearestBuyLiquidityPrice = na
    float nearestSellLiquidityPrice = na

    // Buy Side
    if not na(internalHighDistancePct) and not na(externalHighDistancePct)
        nearestBuyLiquidityPct := math.min(internalHighDistancePct, externalHighDistancePct)
    else if not na(internalHighDistancePct)
        nearestBuyLiquidityPct := internalHighDistancePct
    else if not na(externalHighDistancePct)
        nearestBuyLiquidityPct := externalHighDistancePct

    if not na(nearestBuyLiquidityPct) and not na(atr) and c > 0
        nearestBuyLiquidityPriceDistance := c * nearestBuyLiquidityPct / 100.0
        nearestBuyLiquidityPrice := c + nearestBuyLiquidityPriceDistance
        nearestBuyLiquidityATRDistance := nearestBuyLiquidityPriceDistance / atr

    // Sell Side
    if not na(internalLowDistance) and not na(externalLowDistancePct)
        nearestSellLiquidityPct := math.min(internalLowDistance, externalLowDistancePct)
    else if not na(internalLowDistance)
        nearestSellLiquidityPct := internalLowDistance
    else if not na(externalLowDistancePct)
        nearestSellLiquidityPct := externalLowDistancePct

    if not na(nearestSellLiquidityPct) and not na(atr) and c > 0
        nearestSellLiquidityPriceDistance := c * nearestSellLiquidityPct / 100.0
        nearestSellLiquidityPrice := c - nearestSellLiquidityPriceDistance
        nearestSellLiquidityATRDistance := nearestSellLiquidityPriceDistance / atr

    //==================================================
    // 4.2.17 ORDER BLOCK DETECTION
    //==================================================
    // ORDER BLOCK PERSISTENT MEMORY
    // Stores active OB zones and breaker states.
    // Bullish OB memory
    var float activeBullOBHigh = na
    var float activeBullOBLow  = na
    var float activeStrictBullOBHigh = na
    var float activeStrictBullOBLow  = na
    var int activeBullOBBar = na
    var int activeStrictBullOBBar = na
    var bool bullOBMitigated = false
    var bool bullOBInvalidated = false
    var bool strictBullOBMitigated = false
    var bool strictBullOBInvalidated = false
    var float activeBullOBATR = na
    var bool activeBullOBHasFVG = false
    var bool activeStrictBullOBHasFVG = false

    // Bearish OB memory
    var float activeBearOBHigh = na
    var float activeBearOBLow  = na
    var float activeStrictBearOBHigh = na
    var float activeStrictBearOBLow  = na
    var int activeBearOBBar = na
    var int activeStrictBearOBBar = na
    var bool bearOBMitigated = false
    var bool bearOBInvalidated = false
    var bool strictBearOBMitigated = false
    var bool strictBearOBInvalidated = false
    var float activeBearOBATR = na
    var bool activeBearOBHasFVG = false
    var bool activeStrictBearOBHasFVG = false

    // Breaker memory
    // Pure Breaker
    var float activeBullBreakerHigh = na
    var float activeBullBreakerLow  = na
    var bool bullBreakerActive = false
    var float activeBearBreakerHigh = na
    var float activeBearBreakerLow  = na
    var bool bearBreakerActive = false
    var int activeBullBreakerBar = na
    var int activeBearBreakerBar = na
    var bool bullBreakerHasBeenMitigated = false
    var bool bearBreakerHasBeenMitigated = false

    // Strict Breaker
    var float activeStrictBullBreakerHigh = na
    var float activeStrictBullBreakerLow  = na
    var bool strictBullBreakerActive = false
    var float activeStrictBearBreakerHigh = na
    var float activeStrictBearBreakerLow  = na
    var bool strictBearBreakerActive = false
    var int activeStrictBullBreakerBar = na
    var int activeStrictBearBreakerBar = na
    var bool strictBullBreakerHasBeenMitigated = false
    var bool strictBearBreakerHasBeenMitigated = false

    // Bullish OB persistent state
    var bool activeBullOBHasBeenMitigated = false
    var bool activeStrictBullOBHasBeenMitigated = false

    // Bearish OB persistent state
    var bool activeBearOBHasBeenMitigated = false
    var bool activeStrictBearOBHasBeenMitigated = false

    float strictBullOBHigh = na
    float strictBullOBLow = na

    float strictBearOBHigh = na
    float strictBearOBLow = na

    bool strictBullOBEvent = false
    bool strictBearOBEvent = false

    float bullOBDistance = na
    float bullOBDistanceATR = na
    float bearOBDistance = na
    float bearOBDistanceATR = na

    // DIRECTIONAL DISPLACEMENT
    // Positive = bullish displacement
    // Negative = bearish displacement
    // Used for OB direction validation.
    bool bullishOBDisplacement = directionalDisplacement >= 0.5
    bool bearishOBDisplacement = directionalDisplacement <= -0.5

    // Pure Bullish Order Block
    // Previous bearish candle
    // followed by bullish displacement.
    bool bullOBEvent = prevBearCandle and c > h1 and bullishOBDisplacement
    bullOBHigh = bullOBEvent ? o1 : na
    bullOBLow = bullOBEvent ? l1 : na

    // Pure Bearish Order Block
    // Previous bullish candle
    // followed by bearish displacement.
    bool bearOBEvent = prevBullCandle and c < l1 and bearishOBDisplacement
    bearOBHigh = bearOBEvent ? h1 : na
    bearOBLow = bearOBEvent ? o1 : na

    // PURE OB STRENGTH
    bullOBStrength = bullOBEvent ? displacementATR : 0.0
    bearOBStrength = bearOBEvent ? displacementATR : 0.0
    
    // STRUCTURE BREAK FEATURE
    // Detects confirmed local structure break.
    // Bullish:
    // Price closes above previous confirmed swing high.
    // Bearish:
    // Price closes below previous confirmed swing low.
    // Section 3 only:
    // No score.
    // No signal.
    // No decision.
    bool bullishStructureBreak = not na(prevPivotHigh) and c > prevPivotHigh and c > o
    bool bearishStructureBreak = not na(prevPivotLow) and c < prevPivotLow and c < o

    // STRICT OB FILTER
    // Strict requirements:
    // 1. Pure OB exists
    // 2. Strong displacement
    // 3. Larger candle expansion
    // 4. Structural confirmation
    bool strictBullCondition = bullOBEvent and displacementATR >= 1.0 and candleEfficiency >= 0.60 and volumeRatio >= 1.20 and bullishStructureBreak
    bool strictBearCondition = bearOBEvent and displacementATR >= 1.0 and candleEfficiency >= 0.60 and volumeRatio >= 1.20 and bearishStructureBreak

    if strictBullCondition
        strictBullOBEvent := true
        strictBullOBHigh  := bullOBHigh
        strictBullOBLow   := bullOBLow

    if strictBearCondition
        strictBearOBEvent := true
        strictBearOBHigh  := bearOBHigh
        strictBearOBLow   := bearOBLow

    // Strict OB FVG confluence
    if strictBullOBEvent
        activeStrictBullOBHasFVG := bullFVG

    if strictBearOBEvent
        activeStrictBearOBHasFVG := bearFVG

    // ORDER BLOCK MEMORY UPDATE
    // Store the latest active Order Block.
    // A new valid Order Block replaces the previous one.
    
    // Bullish Order Block
    //Pure OB
    if bullOBEvent
        activeBullOBHigh := bullOBHigh
        activeBullOBLow  := bullOBLow
        activeBullOBHasFVG := bullFVG
        activeBullOBBar  := bar_index
        activeBullOBATR := atr

        bullOBMitigated   := false
        bullOBInvalidated := false
        
        activeBullOBHasBeenMitigated := false

    // Bearish Order Block
    if bearOBEvent
        activeBearOBHigh := bearOBHigh
        activeBearOBLow  := bearOBLow
        activeBearOBHasFVG := bearFVG
        activeBearOBBar  := bar_index
        activeBearOBATR := atr

        bearOBMitigated   := false
        bearOBInvalidated := false

        activeBearOBHasBeenMitigated := false
        
    // Strict OB
    if strictBullOBEvent
        activeStrictBullOBHigh := strictBullOBHigh
        activeStrictBullOBLow  := strictBullOBLow
        activeStrictBullOBBar  := bar_index
        
        strictBullOBMitigated   := false
        strictBullOBInvalidated := false
        
        activeStrictBullOBHasBeenMitigated := false

    if strictBearOBEvent
        activeStrictBearOBHigh := strictBearOBHigh
        activeStrictBearOBLow  := strictBearOBLow
        activeStrictBearOBBar  := bar_index

        strictBearOBMitigated   := false
        strictBearOBInvalidated := false

        activeStrictBearOBHasBeenMitigated := false

    // ORDER BLOCK LIFECYCLE
    // Mitigation requires:
    // - stored OB zone
    // - age
    // - invalidation rules
    // - memory
    // Price has interacted with the active Order Block.
    // Pure OB
    bullOBMitigated := not na(activeBullOBLow) and l <= activeBullOBHigh and h >= activeBullOBLow
    bearOBMitigated := not na(activeBearOBHigh) and h >= activeBearOBLow and l <= activeBearOBHigh

    //Strict OB
    strictBullOBMitigated := not na(activeStrictBullOBLow) and l <= activeStrictBullOBHigh and h >= activeStrictBullOBLow
    strictBearOBMitigated := not na(activeStrictBearOBHigh) and h >= activeStrictBearOBLow and l <= activeStrictBearOBHigh

    // Persistent mitigation state
    // Pure OB
    if bullOBMitigated
        activeBullOBHasBeenMitigated := true

    if bearOBMitigated
        activeBearOBHasBeenMitigated := true

   //Strict OB
    if strictBullOBMitigated
        activeStrictBullOBHasBeenMitigated := true

    if strictBearOBMitigated
        activeStrictBearOBHasBeenMitigated := true

    // INVALIDATION
    //Pure OB
    bullOBInvalidated := not na(activeBullOBLow) and c < activeBullOBLow
    bearOBInvalidated := not na(activeBearOBHigh) and c > activeBearOBHigh

    //Strict OB
    strictBullOBInvalidated := not na(activeStrictBullOBLow) and c < activeStrictBullOBLow
    strictBearOBInvalidated := not na(activeStrictBearOBHigh) and c > activeStrictBearOBHigh

    // age
    // Pure OB
    int bullOBAge = not na(activeBullOBBar) ? bar_index - activeBullOBBar : na
    int bearOBAge = not na(activeBearOBBar) ? bar_index - activeBearOBBar : na

    // Strict OB
    int strictBullOBAge = not na(activeStrictBullOBBar) ? bar_index - activeStrictBullOBBar : na
    int strictBearOBAge = not na(activeStrictBearOBBar) ? bar_index - activeStrictBearOBBar : na

    // BREAKER
    // Pure OB
    if bearOBInvalidated and not na(activeBearOBHigh) and not na(activeBearOBLow)
        activeBullBreakerHigh := activeBearOBHigh
        activeBullBreakerLow  := activeBearOBLow
        activeBullBreakerBar  := bar_index
        bullBreakerHasBeenMitigated := false
        bullBreakerActive := true

    // Clear invalidated Bearish OB
        activeBearOBHigh := na
        activeBearOBLow := na
        activeBearOBBar := na
        activeBearOBATR := na
        activeBearOBHasFVG := false
        activeBearOBHasBeenMitigated := false

    if bullOBInvalidated and not na(activeBullOBHigh) and not na(activeBullOBLow)
        activeBearBreakerHigh := activeBullOBHigh
        activeBearBreakerLow  := activeBullOBLow
        activeBearBreakerBar  := bar_index
        bearBreakerHasBeenMitigated := false
        bearBreakerActive := true

        // Clear invalidated Bullish OB
        activeBullOBHigh := na
        activeBullOBLow := na
        activeBullOBBar := na
        activeBullOBATR := na
        activeBullOBHasFVG := false
        activeBullOBHasBeenMitigated := false

    //Strict OB
    if strictBearOBInvalidated and not na(activeStrictBearOBHigh) and not na(activeStrictBearOBLow)
        activeStrictBullBreakerHigh := activeStrictBearOBHigh
        activeStrictBullBreakerLow  := activeStrictBearOBLow
        activeStrictBullBreakerBar  := bar_index
        strictBullBreakerHasBeenMitigated := false
        strictBullBreakerActive := true

        // Clear invalidated Strict Bearish OB
        activeStrictBearOBHigh := na
        activeStrictBearOBLow := na
        activeStrictBearOBBar := na
        activeStrictBearOBHasFVG := false
        activeStrictBearOBHasBeenMitigated := false

    if strictBullOBInvalidated and not na(activeStrictBullOBHigh) and not na(activeStrictBullOBLow)
        activeStrictBearBreakerHigh := activeStrictBullOBHigh
        activeStrictBearBreakerLow  := activeStrictBullOBLow
        activeStrictBearBreakerBar  := bar_index
        strictBearBreakerHasBeenMitigated := false
        strictBearBreakerActive := true

        // Clear invalidated Bullish OB
        activeStrictBullOBHigh := na
        activeStrictBullOBLow := na
        activeStrictBullOBBar := na
        activeStrictBullOBHasFVG := false
        activeStrictBullOBHasBeenMitigated := false

    bool bullBreakerMitigated = bullBreakerActive and not na(activeBullBreakerLow) and not na(activeBullBreakerHigh) and
         l <= activeBullBreakerHigh and h >= activeBullBreakerLow

    bool bearBreakerMitigated = bearBreakerActive and not na(activeBearBreakerLow) and not na(activeBearBreakerHigh) and
         h >= activeBearBreakerLow and l <= activeBearBreakerHigh

    bool strictBullBreakerMitigated = strictBullBreakerActive and not na(activeStrictBullBreakerLow) and not na(activeStrictBullBreakerHigh) and
         l <= activeStrictBullBreakerHigh and h >= activeStrictBullBreakerLow

    bool strictBearBreakerMitigated = strictBearBreakerActive and not na(activeStrictBearBreakerLow) and not na(activeStrictBearBreakerHigh) and
         h >= activeStrictBearBreakerLow and l <= activeStrictBearBreakerHigh

    if bullBreakerMitigated
        bullBreakerHasBeenMitigated := true

    if bearBreakerMitigated
        bearBreakerHasBeenMitigated := true

    if strictBullBreakerMitigated
        strictBullBreakerHasBeenMitigated := true

    if strictBearBreakerMitigated
        strictBearBreakerHasBeenMitigated := true

    // BREAKER INVALIDATION
    if bullBreakerActive and not na(activeBullBreakerLow) and c < activeBullBreakerLow
        bullBreakerActive := false
    if bearBreakerActive and not na(activeBearBreakerHigh) and c > activeBearBreakerHigh
        bearBreakerActive := false
    if strictBullBreakerActive and not na(activeStrictBullBreakerLow) and c < activeStrictBullBreakerLow
        strictBullBreakerActive := false
    if strictBearBreakerActive and not na(activeStrictBearBreakerHigh) and c > activeStrictBearBreakerHigh
        strictBearBreakerActive := false

    // BREAKER ZONES
    // Pure OB
    float bullBreakerHigh = bullBreakerActive ? activeBullBreakerHigh : na
    float bullBreakerLow = bullBreakerActive ? activeBullBreakerLow : na
    float bearBreakerHigh = bearBreakerActive ? activeBearBreakerHigh : na
    float bearBreakerLow = bearBreakerActive ? activeBearBreakerLow : na

    // Strict OB
    float strictBullBreakerHigh = strictBullBreakerActive ? activeStrictBullBreakerHigh : na
    float strictBullBreakerLow = strictBullBreakerActive ? activeStrictBullBreakerLow : na
    float strictBearBreakerHigh = strictBearBreakerActive ? activeStrictBearBreakerHigh : na
    float strictBearBreakerLow = strictBearBreakerActive ? activeStrictBearBreakerLow : na

    // Breaker Age
    int bullBreakerAge = bullBreakerActive and not na(activeBullBreakerBar) ? bar_index - activeBullBreakerBar : na
    int bearBreakerAge = bearBreakerActive and not na(activeBearBreakerBar) ? bar_index - activeBearBreakerBar : na
    int strictBullBreakerAge = strictBullBreakerActive and not na(activeStrictBullBreakerBar) ? bar_index - activeStrictBullBreakerBar : na
    int strictBearBreakerAge = strictBearBreakerActive and not na(activeStrictBearBreakerBar) ? bar_index - activeStrictBearBreakerBar : na

    // OB LOCATION — PROXIMITY
    // BUY-side OB proximity
    if not na(activeBullOBHigh) and not na(activeBullOBLow) and not na(activeBullOBATR) and activeBullOBATR > 0
        bullOBDistance := c > activeBullOBHigh ? c - activeBullOBHigh : c < activeBullOBLow  ? activeBullOBLow - c : 0.0
        bullOBDistanceATR := bullOBDistance / activeBullOBATR

    // SELL-side OB proximity
    if not na(activeBearOBHigh) and not na(activeBearOBLow) and not na(activeBearOBATR) and activeBearOBATR > 0
        bearOBDistance := c > activeBearOBHigh ? c - activeBearOBHigh : c < activeBearOBLow  ? activeBearOBLow - c : 0.0
        bearOBDistanceATR := bearOBDistance / activeBearOBATR

    // ==================================================
    // 4.2.18 VOLUME PROFILE SETTINGS
    // ==================================================
    float vpPOC = na

    float vpVAHigh = na
    float vpVALow = na

    float vpHVNHigh = na
    float vpHVNLow = na

    float vpLVNHigh = na
    float vpLVNLow = na

    bool priceAbovePOC = false
    bool priceBelowPOC = false

    float distanceToPOC = na
    float distanceToPOCATR = na
    float distanceToVAH = na
    float distanceToVAL = na

    float valueAreaPosition = na

    float vpHigh = ta.highest(h, vpLookback)
    float vpLow = ta.lowest(l, vpLookback)

    float vpRange = vpHigh - vpLow
    float vpBinSize = vpRange / vpBins
    bool vpValid = vpRange > 0 and vpBinSize > 0

    var float[] vpVolumeBins = array.new_float(vpBins,0.0)
    var float prevVpPOC = na
    if vpValid

        if barstate.isnew
            for i = 0 to vpBins - 1
                array.set(vpVolumeBins,i,0.0)

        for i = 0 to vpLookback - 1
            float candleHigh = h[i]
            float candleLow = l[i]
            float candleVolume = volume[i]

            int lowBin = math.floor((candleLow - vpLow) / vpBinSize)
            int highBin = math.floor((candleHigh - vpLow) / vpBinSize)
            lowBin := math.max(0, math.min(vpBins-1,lowBin))
            highBin := math.max(0, math.min(vpBins-1,highBin))

            int touchedBins = highBin-lowBin+1
            float volumePerBin = candleVolume / touchedBins
            for b = lowBin to highBin
                array.set(vpVolumeBins, b, array.get(vpVolumeBins,b) + volumePerBin)

        float maxVolume = 0.0
        int pocIndex = 0
        for i = 0 to vpBins-1
            float binVol = array.get(vpVolumeBins,i)

            if binVol > maxVolume
                maxVolume := binVol
                pocIndex := i

        vpPOC := vpLow + (pocIndex + 0.5) * vpBinSize
        float totalVPVolume = 0.0
        for i = 0 to vpBins-1
            totalVPVolume += array.get(vpVolumeBins,i)

        // VALUE AREA CALCULATION
        float valueTarget = totalVPVolume * vpValueAreaPct / 100
        int vaLowIndex = pocIndex
        int vaHighIndex = pocIndex
        float accumulatedVolume = array.get(vpVolumeBins, pocIndex)

        // Persistent variables OUTSIDE loop scope
        vpVALow := vpLow + vaLowIndex * vpBinSize
        vpVAHigh := vpLow + (vaHighIndex + 1) * vpBinSize
        while accumulatedVolume < valueTarget and (vaLowIndex > 0 or vaHighIndex < vpBins - 1)
            float leftVol = vaLowIndex > 0 ? array.get(vpVolumeBins,vaLowIndex - 1) : 0
            float rightVol = vaHighIndex < vpBins - 1 ? array.get(vpVolumeBins,vaHighIndex + 1) : 0
            if leftVol >= rightVol
                vaLowIndex -= 1
                accumulatedVolume += leftVol

            else
                vaHighIndex += 1
                accumulatedVolume += rightVol

            // Update after expansion
            vpVALow := vpLow + vaLowIndex * vpBinSize
            vpVAHigh := vpLow + (vaHighIndex+1) * vpBinSize

        // PRICE LOCATION AGAINST PROFILE
        priceAbovePOC := c > vpPOC
        priceBelowPOC := c < vpPOC

        // HVN / LVN DETECTION
        float hvnThreshold = maxVolume * 0.70
        float lvnThreshold = maxVolume * 0.30
        for i = 0 to vpBins - 1
            float binVol = array.get(vpVolumeBins, i)
            float binLow = vpLow + i * vpBinSize
            float binHigh = vpLow + (i + 1) * vpBinSize

            if binVol >= hvnThreshold
                vpHVNLow := na(vpHVNLow) ? binLow : math.min(vpHVNLow, binLow)
                vpHVNHigh := na(vpHVNHigh) ? binHigh : math.max(vpHVNHigh, binHigh)

            if binVol <= lvnThreshold
                vpLVNLow := na(vpLVNLow) ? binLow : math.min(vpLVNLow, binLow)
                vpLVNHigh := na(vpLVNHigh) ? binHigh : math.max(vpLVNHigh, binHigh)

    // DISTANCE FROM POC
    // Measures how far price has moved away from
    // Volume Profile fair value.
    // Positive:
    // Price above POC
    // Negative:
    // Price below POC
    if priceBelowPOC
        distanceToPOC:= not na(vpPOC) and c != 0 ? (vpPOC - c) : na
    else if priceAbovePOC
        distanceToPOC:= not na(vpPOC) and c != 0 ? (c - vpPOC) : na

    float distanceToPOCPct = not na(distanceToPOC) and c != 0 ? distanceToPOC / c * 100 : na
    distanceToPOCATR := not na(vpPOC) and atr > 0 ? distanceToPOC / atr : na
    insideValueArea = not na(vpVALow) and not na(vpVAHigh) and c >= vpVALow and c <= vpVAHigh
    valueAreaPosition := vpVAHigh > vpVALow ? (c - vpVALow) / (vpVAHigh - vpVALow) : na
    float vpPOCChange = not na(prevVpPOC) and not na(vpPOC) ? vpPOC - prevVpPOC : na
    prevVpPOC := vpPOC

    // DISTANCE FROM HVN
    // Measures price distance from the nearest
    // h Volume Node zone.
    // Positive:
    // Price above HVN
    // Negative:
    // Price below HVN
    float distanceToHVN =
         not na(vpHVNHigh) and not na(vpHVNLow) and c != 0 ?
         c > vpHVNHigh ?
         (c - vpHVNHigh) / c * 100 :
         c < vpHVNLow ?
         (c - vpHVNLow) / c * 100 :
         0 :
         na

    // DISTANCE FROM LVN
    // Measures price distance from the nearest
    // l Volume Node zone.
    float distanceToLVN =
         not na(vpLVNHigh) and not na(vpLVNLow) and c != 0 ?
         c > vpLVNHigh ?
         (c - vpLVNHigh) / c * 100 :
         c < vpLVNLow ?
         (c - vpLVNLow) / c * 100 :
         0 :
         na

    // DISTANCE FROM VAH
    if not na(vpVAHigh) and vpVAHigh > c
        distanceToVAH:= not na(vpVAHigh) and c != 0 ? (vpVAHigh - c) : na
    if not na(vpVALow) and vpVALow < c
        distanceToVAL:= not na(vpVALow) and c != 0 ? (c - vpVALow) : na

    //==================================================
    // 4.2.19 RANGE LOCATION
    //==================================================
    // Raw location only.
    // No range detection.
    // No regime.
    // No decision.
    //==================================================
    float rangeHigh = ta.highest(h, rangeLookback)
    float rangeLow = ta.lowest(l, rangeLookback)
    float rangeSize = rangeHigh - rangeLow
    float rangePosition = rangeSize > 0 ? (c - rangeLow) / rangeSize : na

    //==================================================
    // 4.2.20 SWING LOCATION
    //==================================================
    float latestSwingHigh = ta.valuewhen(not na(pivotHigh), pivotHigh, 0)
    float latestSwingLow = ta.valuewhen(not na(pivotLow), pivotLow,0)
    float distanceToSwingHigh = not na(latestSwingHigh) and c != 0 ? (latestSwingHigh - c) / c * 100 : na
    float distanceToSwingLow = not na(latestSwingLow) and c != 0 ? (c - latestSwingLow) / c * 100 : na

    //==================================================
    // 4.2.21 SESSION CONTEXT
    //==================================================
    var float asiaHigh = na
    var float asiaLow = na
    var float londonHigh = na
    var float londonLow = na
    var float newYorkHigh = na
    var float newYorkLow = na
    var float prevAsiaHigh = na
    var float prevAsiaLow = na
    var float prevLondonHigh = na
    var float prevLondonLow = na
    var float prevNewYorkHigh = na
    var float prevNewYorkLow = na
    var int asiaHighBar = na
    var int asiaLowBar = na
    var int londonHighBar = na
    var int londonLowBar = na
    var int newYorkHighBar = na
    var int newYorkLowBar = na
    var int prevAsiaHighBar = na
