// 4.2 MARKET FEATURE CALCULATION
// ======================================================
f_market_state(string requiredTF, string engine, int rsiLen, int adxLen, int atrLen, int atrMaLen, int srPivotLen) =>

    // Section 3 Handoff
    MTFData mtfData = f_getMTFData(requiredTF)
    bool hasData = not na(mtfData)
    string tf = f_normalizeTF(requiredTF)
    string executionEngine = engine

    //=========================
    // 4.2.1 PRICE
    //=========================
    float c = mtfData.close
    float o = mtfData.open
    float h = mtfData.high
    float l = mtfData.low
    
    float c1 = mtfData.prevClose
    float o1 = mtfData.prevOpen
    float h1 = mtfData.prevHigh
    float l1 = mtfData.prevLow
    float currentPrice = mtfData.currentPrice

    //=========================
    // 4.2.2 TREND
    //=========================
    float ema7   = ta.ema(c, ema7Len)
    float ema25  = ta.ema(c, ema25Len)
    float ema50  = ta.ema(c, ema50Len)
    float ema100 = ta.ema(c, ema100Len)
    float ema200 = ta.ema(c, ema200Len)
    float ema300 = ta.ema(c, ema300Len)
    float emaGap7_25 = math.abs(ema7-ema25)
    float emaGap25_50 = math.abs(ema25-ema50)
    float emaGap50_100 = math.abs(ema50-ema100)
    float emaGap7_25Pct = emaGap7_25/c
    float emaGap25_50Pct = emaGap25_50/c
    float emaGap50_100Pct = emaGap50_100/c
    float emaCompression = (emaGap7_25Pct + emaGap25_50Pct + emaGap50_100Pct) / 3

    //=========================
    // 4.2.3 EMA STRUCTURE
    //=========================
    bool emaBullStructure = ema7 > ema25 and ema25 > ema50 and ema50 > ema100
    bool emaBearStructure = ema7 < ema25 and ema25 < ema50 and ema50 < ema100
    float ema50DistancePct = not na(ema50) ? math.abs(c - ema50) / c * 100 : na

    // Distance from price to EMA200
    float ema200DistancePct = not na(ema200) ? math.abs(c - ema200) / c * 100 : na
    float ema300DistancePct = not na(ema300) ? math.abs(c - ema300) / c * 100 : na

    // EMA SLOPE
    // Measures EMA movement
    float ema50SlopePct = not na(ema50[1]) ? (ema50 - ema50[1]) / ema50[1] * 100 : 0.0
    float ema200SlopePct = not na(ema200[1]) ? (ema200 - ema200[1]) / ema200[1] * 100 : 0.0
