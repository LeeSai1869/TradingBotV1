// ======================================================
// SECTION 5: MARKET REGIME ENGINE
// ======================================================
//
// PURPOSE:
// Convert Market State measurements into neutral
// market environment.
//
// NO SCORE
// NO SIGNAL
// NO TRADE DECISION
// NO ENTRY
//
// OUTPUT:
// controlState
// energyState
// regimeState
// fatigueState
// trendState
// transitionState
//
// ======================================================

// ======================================================
// 5.1 MARKET REGIME DATA CONTRACT
// ======================================================
type MarketRegime
    string controlState
    string energyState
    string regimeState
    string fatigueState
    string trendState
    string transitionState

// ======================================================
// 5.2MARKET REGIME CALCULATION
// ======================================================
f_market_regime(MarketFeatures f) =>

    // ==================================================
    // CONTROL STATE
    // Who currently controls price?
    // Based on DI dominance only.
    // INPUT:
    // DI+ / DI-
    //
    // OUTPUT:
    // BULL_CONTROL
    // BEAR_CONTROL
    // BALANCED
    // NO_CONTROL
    // ==================================================
    float diDirection = f.diPlus - f.diMinus
    float diStrength = math.abs(diDirection)

    string controlState = diDirection > 10 ? "CONTROL_BULL" : diDirection < -10 ? "CONTROL_BEAR" : diStrength < 5 ? "CONTROL_NONE" : "CONTROL_BALANCED"

    // ==================================================
    // ENERGY STATE
    // Measures market fuel.
    // ADX + ATR expansion + volatility.
    //
    // INPUT:
    // ADX
    // ATR / ATR MA
    //
    // OUTPUT:
    // ENERGY_EXPANDING
    // ENERGY_NORMAL
    // ENERGY_CONTRACTING
    // ENERGY_DEAD
    // ==================================================
    bool atrExpanding = f.atrMARatio > 1.20
    bool atrContracting = f.atrMARatio < 0.80

    string energyState = atrExpanding and f.adx >= 35 ? "ENERGY_EXPANDING" : atrContracting ? "ENERGY_CONTRACTING" : f.adx >= 25 ? "ENERGY_NORMAL" : "ENERGY_DEAD"

    // ==================================================
    // REGIME STATE
    // Market environment classification.
    //
    // INPUT:
    // EMA Structure
    // EMA200 Location
    // EMA50 Location
    // VWAP Location
    // ATR Expansion / Compression
    //
    // OUTPUT:
    // BULL_EXPANSION
    // BEAR_EXPANSION
    // BULL_TREND
    // BEAR_TREND
    // COMPRESSION
    // RANGE
    // ====================================
    // Trend confirmation
    bool bullTrend = f.emaBullStructure and f.priceAboveEMA50 and f.priceAboveEMA200 and f.priceAboveVWAP
    bool bearTrend = f.emaBearStructure and f.priceBelowEMA50 and f.priceBelowEMA200 and f.priceBelowVWAP
    string regimeState = "REGIME_RANGE"

    if bullTrend
        regimeState := atrExpanding ? "REGIME_BULL_EXPANSION" : "REGIME_BULL_TREND"

    else if bearTrend
        regimeState := atrExpanding ? "REGIME_BEAR_EXPANSION" : "REGIME_BEAR_TREND"

    else if atrContracting
        regimeState := "REGIME_COMPRESSION"

    else
        regimeState := "REGIME_RANGE"

    // ==================================================
    // FATIGUE STATE
    // Detects weakening movement / Loss of Momentum.
    //
    // NOT reversal.
    // NOT entry.
    // NOT signal.
    //
    // OUTPUT:
    // FATIGUE_BULLISH
    // FATIGUE_BEARISH
    // NO_FATIGUE
    // This is NOT exhaustion entry logic.
    // Exhaustion belongs to Scalp Engine.
    // ==================================================
    bool bullFatigue = f.emaBullStructure and f.diPlus < f.prevDIPlus and f.adx < f.prevADX
    bool bearFatigue = f.emaBearStructure and f.diMinus < f.prevDIMinus and f.adx < f.prevADX
    string fatigueState = bullFatigue ? "FATIGUE_BULLISH" : bearFatigue ? "FATIGUE_BEARISH" : "FATIGUE_NONE"

    // ==================================================
    // TREND STATE
    // Lifecycle of current directional movement.
    //
    // NOT direction.
    // NOT bullish/bearish.
    // NOT entry.
    //
    // OUTPUT:
    // FRESH
    // MATURE
    // WEAK
    // NONE
    // ==================================================
    float prevDIStrength = math.abs(f.prevDIPlus - f.prevDIMinus)
    bool trendStrengthIncreasing = f.adx > f.prevADX and diStrength > prevDIStrength
    bool trendStrengthDecreasing = f.adx < f.prevADX and diStrength < prevDIStrength
    string trendState = TREND_NONE

    if f.emaBullStructure or f.emaBearStructure
        if trendStrengthIncreasing
            trendState := TREND_FRESH

        else if trendStrengthDecreasing
            trendState := TREND_WEAK

        else
            trendState := TREND_MATURE

    // ==================================================
    // TRANSITION STATE
    // Detects possible regime change.
    //
    // INPUT:
    // Previous regime memory
    // Current regime
    // ADX change
    // EMA compression
    // DI balance
    //
    // OUTPUT:
    // NONE
    // RISK
    // ACTIVE
    //
    // No confirmation.
    // No signal.
    // ==================================================
    string transitionState = TRANSITION_NONE
    bool regimeChanged = marketMemory.lastRegime != "" and marketMemory.lastRegime != "UNKNOWN" and marketMemory.lastRegime != regimeState
    bool weakeningTrend = (regimeState == "REGIME_BULL_TREND" or regimeState == "REGIME_BEAR_TREND" or regimeState == "REGIME_BULL_EXPANSION" or regimeState == "REGIME_BEAR_EXPANSION") and f.adx < f.prevADX
    bool compressionBuilding = f.emaCompression > 0 and atrContracting
    bool activeTransition = regimeChanged

    if activeTransition
        transitionState := TRANSITION_ACTIVE
    else if weakeningTrend or compressionBuilding
        transitionState := TRANSITION_RISK
    else
        transitionState := TRANSITION_NONE

    // 5.3 RETURN
    MarketRegime.new(controlState, energyState, regimeState, fatigueState, trendState, transitionState)

