    int structureAge = not na(structureStartBar) ? bar_index - structureStartBar : na

    // Transition Candidate Phase
    var string activeTransitionType = ""
    var int activeTransition = 0
    var float candidateTransitionHigh = na
    var float candidateTransitionLow = na
    var int candidateTransitionHighBar = na
    var int candidateTransitionLowBar = na

    if activeTransition == 1
        // Pending transition originated from a HIGH candidate.
        // If that candidate high is replaced by a newer high,
        // the old transition candidate is no longer valid.
        if not na(candidateTransitionHighBar)
