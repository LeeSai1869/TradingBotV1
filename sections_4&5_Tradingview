            array.push(structureCHOCH, activeCHOCH)

        array.clear(structurePivotHigh)
        array.clear(structurePivotHighBar)
        array.clear(structurePivotLow)
        array.clear(structurePivotLowBar)
        array.clear(structureHighType)
        array.clear(structureLowType)
        array.clear(structureState)
        array.clear(structureHighsCount)
        array.clear(structureLowsCount)
        array.clear(structureTransition)

        highPivotCount := 0
        lowPivotCount := 0
        candidatePivotHighPrice := na
        candidatePivotHighBar := na
        candidatePivotHighTime := na
        candidatePivotLowPrice := na
        candidatePivotLowBar := na
        candidatePivotLowTime := na
        structureRangeHighBar := na
        structureRangeLowBar := na
        structureRangeHigh := na
        structureRangeLow := na
        candidateTransitionHighBar := na
        candidateTransitionLowBar := na
        originHighBar := na
        originLowBar := na
        ageHighBar := na
        ageLowBar := na
        structureOriginBar := na
        structureStartBar := na
        activeTransitionType := ""
        activeBOSType := ""
        activeBOS := 0
        candidatePivot := 0
        bosCandidatePivotType := 0
        bosCandidatePivotBar := na
        swingTransition := 0
        lastConfirmedPivotType := 0
        foundationPivotHigh := na
        foundationPivotHighBar := na
        foundationPivotLow := na
        foundationPivotLowBar := na
        newHighCount := 0
        newLowCount := 0
        activeTransition := 0
        candidateTransitionHigh := na
        candidateTransitionLow := na
        structureCandidateHighPrice := na
        structureCandidateHighBar := na
        structureCandidateHighTime := na
        structureCandidateLowPrice := na
        structureCandidateLowBar := na
        structureCandidateLowTime := na
        prevCandidatePivotHighBar := na
        prevCandidatePivotLowBar := na
        pivotHighConfirmationPrice := na
        pivotLowConfirmationPrice := na
        structureWasActiveBeforeBar := false
        protectedLow := na
        protectedLowBar := na
        protectedHigh := na
        protectedHighBar := na
        protectedHighType := na
        protectedLowType := na

    string lastStructureBOS = array.size(structureBOS) > 0 ? array.get(structureBOS, array.size(structureBOS) - 1) : ""
    string lastStructureCHOCH = array.size(structureCHOCH) > 0 ? array.get(structureCHOCH, array.size(structureCHOCH) - 1) : ""

    //=========================
    // 4.2.11 FAIR VALUE GAP
    //=========================
    // FVG FAILURE MEMORY (TEMPORARY)
    // Stores the most recent failed FVG event.
    // Unlike active FVG memory, only one failure is retained.
    // Cleared by expiry or replacement.
    // 1 = Bullish FVG failed
    // -1 = Bearish FVG failed
    var float fvgFailureLow = na
    var float fvgFailureHigh = na
    var float fvgFailureStrength = na
    var int fvgFailureDirection = 0
    var int fvgFailureBar = na
    var float fvgFailureReactionImpact = na
    var int fvgFailureCreatedBar = na

    float nearestBullFVGReactionScoreNormalized = na
    float nearestBearFVGReactionScoreNormalized = na

    bool validATR = not na(atr) and atr > 0  

    // FVG Detection / Creation
    bool bullFVG = l > h[2]
    bool bearFVG = h < l[2]

    // Zone Boundaries
    float bullFVGHigh = bullFVG ? l : na
    float bullFVGLow  = bullFVG ? h[2] : na

    float bearFVGHigh = bearFVG ? l[2] : na
    float bearFVGLow  = bearFVG ? h : na
    // FVG size
    float bullGap = bullFVG ? l - h[2] : na
    float bearGap = bearFVG ? l[2] - h : na
    float fvgSize = not na(bullGap) ? bullGap : not na(bearGap) ? bearGap : na

    // Initial Strength
    float bullGapATR = bullFVG ? bullGap/atr : na
    float bearGapATR = bearFVG ? bearGap/atr : na

    float bullFVGStrength = bullFVG and validATR ? bullGapATR >= FVG_STRONG_ATR_MULT ? 3 : bullGapATR >= FVG_MIN_ATR_MULT ? 2 : 0 :0
    float bearFVGStrength = bearFVG and validATR ? bearGapATR >= FVG_STRONG_ATR_MULT ? 3 : bearGapATR >= FVG_MIN_ATR_MULT ? 2 : 0 :0

    // FVG QUALITY FILTER
    bool qualifiedBullFVG = bullFVG and validATR and bullGapATR >= FVG_MIN_ATR_MULT
    bool qualifiedBearFVG = bearFVG and validATR and bearGapATR >= FVG_MIN_ATR_MULT

    // FVG MEMORY UPDATE
    // CREATE NEW BULLISH FVG
    // Only valid FVGs are stored.
    // Newly stored FVGs always start as FRESH.
    // No lifecycle management is performed here.
    if qualifiedBullFVG
        array.push(fvgBullLow, bullFVGLow)
        array.push(fvgBullHigh, bullFVGHigh)
        array.push(fvgBullStrength, bullFVGStrength)
