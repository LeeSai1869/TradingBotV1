    float ema50_200GapPct = not na(ema200) and ema200 != 0 ? math.abs(ema50 - ema200) / ema200 * 100 : 0.0

    // Nearest EMA
    float[] emaValues = array.from(ema7, ema25, ema50, ema100, ema200, ema300)

    float nearestBuyEMA = na
    float nearestBuyEMADistance = na
