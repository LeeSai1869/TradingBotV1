                maxDynamicResistanceES := na(maxDynamicResistanceES) ? resistanceES : math.max(maxDynamicResistanceES, resistanceES)
                minDynamicResistanceWeakTouches := na(minDynamicResistanceWeakTouches) ? int(weakTouches) : math.min(minDynamicResistanceWeakTouches, int(weakTouches))
                maxDynamicResistanceWeakTouches := na(maxDynamicResistanceWeakTouches) ? int(weakTouches) : math.max(maxDynamicResistanceWeakTouches, int(weakTouches))
                minDynamicResistanceStrongTouches := na(minDynamicResistanceStrongTouches) ? int(strongTouches) : math.min(minDynamicResistanceStrongTouches, int(strongTouches))
                maxDynamicResistanceStrongTouches := na(maxDynamicResistanceStrongTouches) ? int(strongTouches) : math.max(maxDynamicResistanceStrongTouches, int(strongTouches))

                int lastTestBar = array.get(resistanceLastTestBarArray, i)
                if not na(lastTestBar)
                    float lastTestAge = math.max(0.0, bar_index - lastTestBar)
                    dynamicResistanceLastTestAgeSum += lastTestAge
                    dynamicResistanceLastTestAgeCount += 1
                    minDynamicResistanceLastTestAge := na(minDynamicResistanceLastTestAge) ? lastTestAge : math.min(minDynamicResistanceLastTestAge, lastTestAge)
                    maxDynamicResistanceLastTestAge := na(maxDynamicResistanceLastTestAge) ? lastTestAge : math.max(maxDynamicResistanceLastTestAge, lastTestAge)

    averageDynamicResistanceScore := dynamicResistanceCount > 0 ? dynamicResistanceScoreSum / dynamicResistanceCount : na
    averageDynamicResistanceES := dynamicResistanceCount > 0 ? dynamicResistanceESSum / dynamicResistanceCount : na
    averageDynamicResistanceLastTestAge := dynamicResistanceLastTestAgeCount > 0 ? dynamicResistanceLastTestAgeSum / dynamicResistanceLastTestAgeCount : na
    dynamicResistanceWTNormalized := normalizeRelative(nearestResistanceWeakTouches, minDynamicResistanceWeakTouches, maxDynamicResistanceWeakTouches, normalizationPower, true)
    dynamicResistanceSTNormalized := normalizeRelative(nearestResistanceStrongTouches, minDynamicResistanceStrongTouches, maxDynamicResistanceStrongTouches, normalizationPower, true)
    dynamicResistanceESNormalized := normalizeRelative(nearestResistanceES, minDynamicResistanceES, maxDynamicResistanceES, normalizationPower, true)
    dynamicResistanceLastTestAgeNormalized := normalizeRelative(nearestResistanceLastTestAge, minDynamicResistanceLastTestAge, maxDynamicResistanceLastTestAge, normalizationPower, false)

    // INSTITUTIONAL RESISTANCE
    float instResistanceScoreSum = 0.0
    float instResistanceESSum = 0.0
    float instResistanceLastTestAgeSum = 0.0
    int instResistanceCount = 0
    int instResistanceLastTestAgeCount = 0
    float minInstResistanceLastTestAge = na
    float maxInstResistanceLastTestAge = na
    float minInstResistanceES = na
    float maxInstResistanceES = na
    int minInstResistanceWeakTouches = na
    int maxInstResistanceWeakTouches = na
    int minInstResistanceStrongTouches = na
    int maxInstResistanceStrongTouches = na
    int maxInstResistanceFailures = na
    int minInstResistanceFailures = na
    if array.size(instResistanceZoneIDArray) > 0
        for i = 0 to array.size(instResistanceZoneIDArray) - 1
            string instZoneID = array.get(instResistanceZoneIDArray, i)
            int dynamicIndex = array.indexof(resistanceZoneIDArray, instZoneID)
            if dynamicIndex != -1
                float resistanceES = array.get(resistanceESArray, dynamicIndex)
                float resistanceScore = array.get(instResistanceScoreArray, i)
                float strongTouches = array.get(resistanceStrongRejectArray, dynamicIndex)
                float totalTouches = array.get(resistanceTouchArray, dynamicIndex)
                float weakTouches = math.max(0.0, totalTouches - strongTouches)
                float instFailures = array.get(instResistanceFailureCountArray, i)
                instResistanceScoreSum += resistanceScore
                instResistanceESSum += resistanceES
                instResistanceCount += 1
                minInstResistanceES := na(minInstResistanceES) ? resistanceES : math.min(minInstResistanceES, resistanceES)
                maxInstResistanceES := na(maxInstResistanceES) ? resistanceES : math.max(maxInstResistanceES, resistanceES)
                minInstResistanceWeakTouches := na(minInstResistanceWeakTouches) ? int(weakTouches) : math.min(minInstResistanceWeakTouches, int(weakTouches))
                maxInstResistanceWeakTouches := na(maxInstResistanceWeakTouches) ? int(weakTouches) : math.max(maxInstResistanceWeakTouches, int(weakTouches))
                minInstResistanceStrongTouches := na(minInstResistanceStrongTouches) ? int(strongTouches) : math.min(minInstResistanceStrongTouches, int(strongTouches))
                maxInstResistanceStrongTouches := na(maxInstResistanceStrongTouches) ? int(strongTouches) : math.max(maxInstResistanceStrongTouches, int(strongTouches))
                minInstResistanceFailures := na(minInstResistanceFailures) ? int(instFailures) : math.min(minInstResistanceFailures, int(instFailures))
                maxInstResistanceFailures := na(maxInstResistanceFailures) ? int(instFailures) : math.max(maxInstResistanceFailures, int(instFailures))

                int lastTestBar = array.get(resistanceLastTestBarArray, dynamicIndex)
                if not na(lastTestBar)
                    float lastTestAge = math.max(0.0, bar_index - lastTestBar)
                    instResistanceLastTestAgeSum += lastTestAge
                    instResistanceLastTestAgeCount += 1
                    minInstResistanceLastTestAge := na(minInstResistanceLastTestAge) ? lastTestAge : math.min(minInstResistanceLastTestAge, lastTestAge)
                    maxInstResistanceLastTestAge := na(maxInstResistanceLastTestAge) ? lastTestAge : math.max(maxInstResistanceLastTestAge, lastTestAge)

    averageInstResistanceScore := instResistanceCount > 0 ? instResistanceScoreSum / instResistanceCount : na
    averageInstResistanceES := instResistanceCount > 0 ? instResistanceESSum / instResistanceCount : na
    averageInstResistanceLastTestAge := instResistanceLastTestAgeCount > 0 ? instResistanceLastTestAgeSum / instResistanceLastTestAgeCount : na
    instResistanceWTNormalized := normalizeRelative(nearestResistanceWeakTouches, minInstResistanceWeakTouches, maxInstResistanceWeakTouches, normalizationPower, true)
    instResistanceSTNormalized := normalizeRelative(nearestResistanceStrongTouches, minInstResistanceStrongTouches, maxInstResistanceStrongTouches, normalizationPower, true)
    instResistanceESNormalized := normalizeRelative(nearestInstResistanceES, minInstResistanceES, maxInstResistanceES, normalizationPower, true)
    instResistanceFailureNormalized := normalizeRelative(nearestInstResistanceFailureCount, minInstResistanceFailures, maxInstResistanceFailures, normalizationPower, true)
    instResistanceLastTestAgeNormalized := normalizeRelative(nearestInstResistanceLastTestAge, minInstResistanceLastTestAge, maxInstResistanceLastTestAge, normalizationPower, false)

    //=========================
    // 4.2.10 MARKET STRUCTURE
    //=========================
    // PIVOTS AND SWING
    var int candidatePivot = 0
    var float candidatePivotHighPrice = na
    var int candidatePivotHighBar = na
    var int candidatePivotHighTime = na
    var float candidatePivotLowPrice = na
    var int candidatePivotLowBar = na
    var int candidatePivotLowTime = na
    var int prevCandidatePivotHighBar = na
    var int prevCandidatePivotLowBar = na
    var float latestConfirmedPivotHigh = na
    var float latestConfirmedPivotLow = na
    var string currentSwingDirection = "NO SWING"
    var int lastConfirmedPivotType = 0
    // Swing Transition
    // "0" means no Transition
    // "1" means Transition Phase
    var int swingTransition = 0
    var float pivotHighConfirmationPrice = na
    var float pivotLowConfirmationPrice = na
    float swingValidationRatio = 0.25

    // Initialize Candidate Pivot
    if barstate.isconfirmed
        if candidatePivot == 0
            if h > h[1]
                candidatePivot := 1
                candidatePivotHighPrice := h
                candidatePivotHighBar := bar_index
                candidatePivotHighTime := time
                currentSwingDirection := "SWING_UP"

            else if l < l[1]
                candidatePivot := -1
                candidatePivotLowPrice := l
                candidatePivotLowBar := bar_index
                candidatePivotLowTime := time
                currentSwingDirection := "SWING_DOWN"

    // Update Candidate Pivot High
    if barstate.isconfirmed and candidatePivot == 1
        if h > candidatePivotHighPrice
            prevCandidatePivotHighBar := candidatePivotHighBar
            candidatePivotHighPrice := h
            candidatePivotHighBar := bar_index
            candidatePivotHighTime := time
            currentSwingDirection := "SWING_UP"
            swingTransition := 0

    int swingLowCount = array.size(swingLowPriceArray)
    if swingLowCount > 0
        latestConfirmedPivotLow := array.get(swingLowPriceArray, swingLowCount - 1)
        float swingDistance = candidatePivotHighPrice - latestConfirmedPivotLow
        float validationDistance = swingDistance * swingValidationRatio
        pivotHighConfirmationPrice := candidatePivotHighPrice - validationDistance
    
    if barstate.isconfirmed and h < candidatePivotHighPrice and c > pivotHighConfirmationPrice
        currentSwingDirection := "SWING_UP"
        swingTransition := 1

    else if barstate.isconfirmed and c <= pivotHighConfirmationPrice
        lastConfirmedPivotType := 1
        array.push(swingHighPriceArray, candidatePivotHighPrice)
        array.push(swingHighBarArray, candidatePivotHighBar)
        array.push(swingHighTimeArray, candidatePivotHighTime)

        int activePivotCount = array.size(currentActivePivotTypeArray)
        if activePivotCount > 0
            array.push(prevActivePivotTypeArray, array.get(currentActivePivotTypeArray, activePivotCount - 1))
        array.push(currentActivePivotTypeArray, 1)

        pivotHighConfirmationPrice := na
        prevCandidatePivotHighBar := na
        currentSwingDirection := "SWING_DOWN"
        candidatePivot := -1
        swingTransition := 0
        candidatePivotLowPrice := l
        candidatePivotLowBar := bar_index
        candidatePivotLowTime := time
        latestConfirmedPivotLow := na

    // Update Candidate Pivot Low
    if barstate.isconfirmed and candidatePivot == -1
        if l < candidatePivotLowPrice
            prevCandidatePivotLowBar := candidatePivotLowBar
            candidatePivotLowPrice := low
            candidatePivotLowBar := bar_index
            candidatePivotLowTime := time
            currentSwingDirection := "SWING_DOWN"
            swingTransition := 0

    int swingHighCount = array.size(swingHighPriceArray)
    if swingHighCount > 0
        latestConfirmedPivotHigh := array.get(swingHighPriceArray, swingHighCount - 1)
        float swingDistance = latestConfirmedPivotHigh - candidatePivotLowPrice
        float validationDistance = swingDistance * swingValidationRatio
        pivotLowConfirmationPrice := candidatePivotLowPrice + validationDistance

    if barstate.isconfirmed and l > candidatePivotLowPrice and c < pivotLowConfirmationPrice
        currentSwingDirection := "SWING_DOWN"
        swingTransition := 1

    else if barstate.isconfirmed and c >= pivotLowConfirmationPrice
        lastConfirmedPivotType := -1
        array.push(swingLowPriceArray, candidatePivotLowPrice)
        array.push(swingLowBarArray, candidatePivotLowBar)
        array.push(swingLowTimeArray, candidatePivotLowTime)

        int activePivotCount = array.size(currentActivePivotTypeArray)
        if activePivotCount > 0
            array.push(prevActivePivotTypeArray, array.get(currentActivePivotTypeArray, activePivotCount - 1))
        array.push(currentActivePivotTypeArray, -1)

        pivotLowConfirmationPrice := na
        prevCandidatePivotLowBar := na
        currentSwingDirection := "SWING_UP"
        candidatePivot := 1
        swingTransition := 0
        candidatePivotHighPrice := h
        candidatePivotHighBar := bar_index
        candidatePivotHighTime := time
        latestConfirmedPivotHigh := na

    float currentActivePivotHigh = array.size(swingHighPriceArray) > 0 ? array.get(swingHighPriceArray, array.size(swingHighPriceArray) - 1) : na
    float currentActivePivotLow = array.size(swingLowPriceArray) > 0 ? array.get(swingLowPriceArray, array.size(swingLowPriceArray) - 1) : na
    int currentActivePivotType = array.size(currentActivePivotTypeArray) > 0 ? array.get(currentActivePivotTypeArray, array.size(currentActivePivotTypeArray) - 1) : 0
    int currentActivePivotBar = (currentActivePivotType == 1 ? (array.size(swingHighBarArray) > 0 ? array.get(swingHighBarArray, array.size(swingHighBarArray) - 1) : na) :
     currentActivePivotType == -1 ? (array.size(swingLowBarArray) > 0 ? array.get(swingLowBarArray, array.size(swingLowBarArray) - 1) : na) : na)

    int prevActivePivotType = array.size(prevActivePivotTypeArray) > 0 ? array.get(prevActivePivotTypeArray, array.size(prevActivePivotTypeArray) - 1) : 0
    float prevActivePivotHigh = prevActivePivotType == 1 and array.size(swingHighPriceArray) > 1 ? array.get(swingHighPriceArray, array.size(swingHighPriceArray) - 2) : na
    float prevActivePivotLow = prevActivePivotType == -1 and array.size(swingLowPriceArray) > 1 ? array.get(swingLowPriceArray, array.size(swingLowPriceArray) - 2) : na
    int prevActivePivotBar = (prevActivePivotType == 1 ? (array.size(swingHighBarArray) > 1 ? array.get(swingHighBarArray, array.size(swingHighBarArray) - 2) : na) :
     prevActivePivotType == -1 ? (array.size(swingLowBarArray) > 1 ? array.get(swingLowBarArray, array.size(swingLowBarArray) - 2) : na) : na)

    float nearestSwingHigh = not na(currentActivePivotHigh) and currentActivePivotHigh > c ? currentActivePivotHigh : na
    float nearestSwingLow  = not na(currentActivePivotLow) and currentActivePivotLow < c ? currentActivePivotLow : na
    float distanceToSwingHighPct = not na(nearestSwingHigh) and c != 0 ? (nearestSwingHigh - c) / c * 100 : na
    float distanceToSwingLowPct  = not na(nearestSwingLow) and c != 0 ? (c - nearestSwingLow) / c * 100 : na
    int nearestSwingHighBar = array.size(swingHighBarArray) > 0 ? array.get(swingHighBarArray, array.size(swingHighBarArray) - 1) : na
    int nearestSwingLowBar  = array.size(swingLowBarArray) > 0 ? array.get(swingLowBarArray, array.size(swingLowBarArray) - 1) : na
    int nearestSwingHighTime = not na(nearestSwingHigh) and array.size(swingHighTimeArray) > 0 ? array.get(swingHighTimeArray, array.size(swingHighTimeArray) - 1) : na
    int nearestSwingLowTime  = not na(nearestSwingLow) and array.size(swingLowTimeArray) > 0 ? array.get(swingLowTimeArray, array.size(swingLowTimeArray) - 1) : na

    //STRUCTURE
    var int newHighCount = 0
    var int newLowCount = 0
    var int structureRangeHighBar = na
    var int structureRangeLowBar = na
    var float structureRangeHigh = na
    var float structureRangeLow = na
    var int originHighBar = na
    var int originLowBar = na
    var int ageHighBar = na
    var int ageLowBar = na
    var int structureOriginBar = na
    var int structureStartBar = na
    float pivotEstablishmentRetracement = 0.20

    // Structure Foundation Pivots
    var float foundationPivotHigh = na
    var int foundationPivotHighBar = na
    var float foundationPivotLow = na
    var int foundationPivotLowBar = na

    if array.size(structureState) == 0
        if swingHighCount >= 2
            foundationPivotHigh := array.get(swingHighPriceArray, swingHighCount - 2)
            foundationPivotHighBar := array.get(swingHighBarArray, swingHighCount - 2)
            array.push(structurePivotHigh, foundationPivotHigh)
            array.push(structurePivotHighBar, foundationPivotHighBar)
            array.push(structureHighType, "High")
            newHighCount += 1
            array.push(structureHighsCount, newHighCount)
            originHighBar := foundationPivotHighBar

        if swingLowCount >= 2
            foundationPivotLow := array.get(swingLowPriceArray, swingLowCount - 2)
            foundationPivotLowBar := array.get(swingLowBarArray, swingLowCount - 2)
            array.push(structurePivotLow, foundationPivotLow)
            array.push(structurePivotLowBar, foundationPivotLowBar)
            array.push(structureLowType, "Low")
            newLowCount += 1
            array.push(structureLowsCount, newLowCount)
            originLowBar := foundationPivotLowBar

    // Structure High Pivot Types
    var float structureCandidateHighPrice = na
    var int structureCandidateHighBar = na
    var int structureCandidateHighTime = na

    if candidatePivot == 1 and prevCandidatePivotHighBar == structureCandidateHighBar
        structureCandidateHighPrice := na
        structureCandidateHighBar := na
        structureCandidateHighTime := na

    if candidatePivot == 1 and swingTransition == 1
        structureCandidateHighPrice := candidatePivotHighPrice
        structureCandidateHighBar := candidatePivotHighBar
        structureCandidateHighTime := candidatePivotHighTime

    float activePivotHigh = array.size(structurePivotHigh) > 0 ? array.get(structurePivotHigh, array.size(structurePivotHigh) - 1) : na
    float candidateRangeDistance = not na(foundationPivotHigh) and not na(foundationPivotLow) ? foundationPivotHigh - foundationPivotLow : na
    string foundationHighType = "High"
    string newHighType = na

    if not na(candidateRangeDistance) and structureCandidateHighPrice >= activePivotHigh - candidateRangeDistance * pivotEstablishmentRetracement and structureCandidateHighPrice <= activePivotHigh
        newHighType := "EH"

    else if structureCandidateHighPrice > activePivotHigh
        newHighType := "HH"

    else if structureCandidateHighPrice < activePivotHigh
        newHighType := "LH"

    // Structure Low Pivot Types
    var float structureCandidateLowPrice = na
    var int structureCandidateLowBar = na
    var int structureCandidateLowTime = na

    if candidatePivot == -1 and prevCandidatePivotLowBar == structureCandidateLowBar
        structureCandidateLowPrice := na
        structureCandidateLowBar := na
        structureCandidateLowTime := na

    if candidatePivot == -1 and swingTransition == 1
        structureCandidateLowPrice := candidatePivotLowPrice
        structureCandidateLowBar := candidatePivotLowBar
        structureCandidateLowTime := candidatePivotLowTime

    float activePivotLow = array.size(structurePivotLow) > 0 ? array.get(structurePivotLow, array.size(structurePivotLow) - 1) : na
    float candidateRangeDistanceLow = not na(foundationPivotHigh) and not na(foundationPivotLow) ? foundationPivotHigh - foundationPivotLow : na
    string foundationLowType = "Low"
    string newLowType = na

    if not na(candidateRangeDistanceLow) and structureCandidateLowPrice <= activePivotLow + candidateRangeDistanceLow * pivotEstablishmentRetracement and structureCandidateLowPrice >= activePivotLow
        newLowType := "EL"
    else if structureCandidateLowPrice < activePivotLow
        newLowType := "LL"
    else if structureCandidateLowPrice > activePivotLow
        newLowType := "HL"

    // Structure State Definitions / identification
    int highPivotCount = array.size(structureHighsCount)
    int lowPivotCount  = array.size(structureLowsCount)
    bool hasBullishHigh = false
    bool hasBullishLow  = false
    bool hasBearishHigh = false
    bool hasBearishLow  = false
    bool hasStructureRangeHigh = false
    bool hasStructureRangeLow  = false

    if highPivotCount == 2
        string latestHighType = array.get(structureHighType, highPivotCount - 1)

        hasBullishHigh := latestHighType == "HH"
        hasBearishHigh := latestHighType == "LH"
        hasStructureRangeHigh := latestHighType == "EH"

    if lowPivotCount == 2
        string latestLowType = array.get(structureLowType, lowPivotCount - 1)

        hasBullishLow := latestLowType == "HL"
        hasBearishLow := latestLowType == "LL"
        hasStructureRangeLow := latestLowType == "EL"

    bool bullishStructure = highPivotCount >= 2 and lowPivotCount >= 2 and hasBullishHigh and hasBullishLow
    bool bearishStructure = highPivotCount >= 2 and lowPivotCount >= 2 and hasBearishHigh and hasBearishLow
    bool rangeStructure = hasStructureRangeHigh and hasStructureRangeLow and highPivotCount >= 2 and lowPivotCount >= 2

    // Structure Establishment
    bool structureWasActiveBeforeBar = array.size(structureState) > 0
    string structureEstablished = na
    if bullishStructure
        structureEstablished := "STRUCTURE_BULL"

    else if bearishStructure
        structureEstablished := "STRUCTURE_BEAR"

    else if rangeStructure
        structureEstablished := "STRUCTURE_RANGE"

    bool newStructureEstablished = not na(structureEstablished) and (not structureWasActiveBeforeBar or array.get(structureState, array.size(structureState) - 1) != structureEstablished)
    if newStructureEstablished
        if not na(originHighBar) and not na(originLowBar)
            structureOriginBar := math.min(originHighBar, originLowBar)

        if structureEstablished == "STRUCTURE_RANGE"
            int rangeHighIndex = array.size(structurePivotHighBar) - 1
            int rangeLowIndex = array.size(structurePivotLowBar) - 1

            structureRangeHighBar := array.get(structurePivotHighBar, rangeHighIndex)
            structureRangeLowBar := array.get(structurePivotLowBar, rangeLowIndex)
        array.push(structureState, structureEstablished)
        structureWasActiveBeforeBar := true

